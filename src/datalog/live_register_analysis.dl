.decl live_register_name(Index:unsigned,Name:symbol)
.output live_register_name

live_register_name(Index,Name):-
    arch.lra_register(_,Index,Name).

.decl lra_instruction(EA:address)

lra_instruction(EA):-
    code_in_refined_block(EA,_),
    arch.lra_register(_,_,_).

.decl lra_internal_call_edge(Block:address,Dest:address)

lra_internal_call_edge(Block,Dest):-
    cfg_edge(Block,Dest,_,_,"call"),
    !plt_block(Dest,_).

.decl lra_internal_call(Block:address)

lra_internal_call(Block):-
    lra_internal_call_edge(Block,_).

// Follow a callee's branches and call continuations, not nested call edges.
// Returns can belong to shared epilogues or another inferred function. Using
// CFG reachability also includes conditional tail calls without trusting those
// function boundaries to establish which caller values may be observed.
.decl lra_callee_block(Entry:address,Block:address)

lra_callee_block(Entry,Entry):-
    lra_internal_call_edge(_,Entry).

lra_callee_block(Entry,Next):-
    lra_callee_block(Entry,Block),
    cfg_edge(Block,Next,_,_,Type),
    (Type = "branch"; Type = "fallthrough"),
    !plt_block(Next,_).

.decl lra_callee_return(Entry:address,EA:address)

lra_callee_return(Entry,EA):-
    lra_callee_block(Entry,Block),
    refined_block_last_instruction(Block,EA),
    arch.return(EA).

.decl lra_call_continuation(Entry:address,Next:address)

lra_call_continuation(Entry,Next):-
    lra_internal_call_edge(Caller,Entry),
    cfg_edge(Caller,Next,_,_,"fallthrough").

.decl lra_next(EA:address,Next:address)

// Sequential instructions within a basic block.
lra_next(EA,Next):-
    code_in_refined_block(EA,Block),
    next(EA,Next),
    code_in_refined_block(Next,Block).

// Enter known callees rather than applying a calling-convention summary.
lra_next(EA,Dest):-
    refined_block_last_instruction(Block,EA),
    lra_internal_call_edge(Block,Dest).

// Ordinary inter-block edges, including continuation after external calls.
lra_next(EA,Dest):-
    refined_block_last_instruction(Block,EA),
    cfg_edge(Block,Dest,_,_,Type),
    Type != "call",
    !lra_internal_call(Block).

lra_next(EA,Dest):-
    refined_block_last_instruction(Block,EA),
    cfg_edge(Block,Dest,_,_,Type),
    Type != "call",
    Type != "fallthrough".

// Return from known callees, including chains of recovered tail calls.
lra_next(EA,Next):-
    lra_callee_return(Entry,EA),
    lra_call_continuation(Entry,Next).

.decl lra_use(EA:address,Reg:register)

lra_use(EA,Reg):-
    lra_instruction(EA),
    reg_def_use.used(EA,Reg,_),
    arch.lra_register(Reg,_,_),
    !arch.lra_vector_register(Reg).

lra_use(EA,Reg):-
    lra_instruction(EA),
    vector_register_access(EA,Reg,"R"),
    arch.lra_vector_register(Reg).

lra_use(EA,Reg):-
    lra_instruction(EA),
    arch.lra_extra_use(EA,Reg),
    arch.lra_register(Reg,_,_).

// Relinking can replace a defined weak symbol with a different implementation.
// Its current body therefore cannot establish dead inputs, even for a direct
// call or tail branch. Retain every tracked register as for an unknown target.
lra_use(EA,Reg):-
    refined_block_last_instruction(Block,EA),
    cfg_edge(Block,Dest,_,_,Type),
    (Type = "call"; Type = "branch"),
    defined_symbol(Dest,_,_,"WEAK",_,_,_,_,_),
    arch.lra_register(Reg,_,_).

// The kernel calling convention is not the ordinary function ABI. Without an
// OS-specific summary, retain all tracked registers at the system-call boundary.
lra_use(EA,Reg):-
    lra_instruction(EA),
    instruction(EA,_,_,Operation,_,_,_,_,_,_),
    arch.syscall_operation(Operation),
    arch.lra_register(Reg,_,_).

.decl lra_external_call(EA:address)

lra_external_call(EA):-
    refined_block_last_instruction(Block,EA),
    cfg_edge_to_symbol(Block,_,_,_,"call").

lra_external_call(EA):-
    refined_block_last_instruction(Block,EA),
    cfg_edge_to_top(Block,_,"call").

lra_external_call(EA):-
    direct_call(EA,Dest),
    plt_block(Dest,_).

// 256- and 512-bit vector arguments and results (__m256, __m512, the vector
// math ABI) also use the upper pieces of YMM0-7 and ZMM0-7. They count as
// arguments and results only in a module whose refined code accesses an upper
// piece: a YMM or ZMM operand, any VEX or EVEX write to a vector register (which
// zeroes the pieces above it), VZEROUPPER or VZEROALL, the XSAVE family, or the
// XRSTOR family (which restores them although the loader records no write for
// it). A ZMM piece brings the YMM one.
// Legacy SSE leaves the upper pieces alone, so in other modules no instruction
// of the module can change them, and counting them would only make every
// checkpoint before a call save them. A value merely passed through such a
// module stays unprotected where speculation continues into another
// instrumented module that changes it.
.decl lra_upper_vector_width(Prefix:symbol)

lra_upper_vector_width(Prefix):-
    binary_format("ELF"),
    vector_register_access(EA,Reg,_),
    (Prefix = "YMM"; Prefix = "ZMM"),
    substr(Reg,0,3) = Prefix,
    code_in_refined_block(EA,_).

lra_upper_vector_width(Prefix):-
    binary_format("ELF"),
    code_in_refined_block(EA,_),
    instruction_get_operation(EA,Operation),
    substr(Operation,0,6) = "XRSTOR",
    (Prefix = "YMM"; Prefix = "ZMM").

lra_upper_vector_width("YMM"):-
    lra_upper_vector_width("ZMM").

.decl lra_abi_argument_register(Reg:register)

lra_abi_argument_register(Reg):-
    arch.lra_argument_register(Reg).

lra_abi_argument_register(cat(Prefix,to_string(I),"H")):-
    lra_upper_vector_width(Prefix),
    I = range(0,8,1).

.decl lra_abi_return_register(Reg:register)

lra_abi_return_register(Reg):-
    arch.lra_return_register(Reg).

lra_abi_return_register(cat(Prefix,"0H")):-
    lra_upper_vector_width(Prefix).

// External calls consume ABI argument registers.
lra_use(EA,Reg):-
    lra_external_call(EA),
    lra_abi_argument_register(Reg),
    arch.lra_register(Reg,_,_).

// A direct external tail call consumes arguments and must preserve nonvolatile
// registers for its caller.
lra_use(EA,Reg):-
    refined_block_last_instruction(Block,EA),
    cfg_edge_to_symbol(Block,_,_,"false","branch"),
    (
        lra_abi_argument_register(Reg);
        arch.lra_register(Reg,_,_),
        !arch.lra_caller_saved(Reg)
    ).

// Without a complete target set, preserve every tracked register.
lra_use(EA,Reg):-
    lra_instruction(EA),
    !arch.return(EA),
    (
        indirect_call(EA);
        indirect_jump(EA);
        reg_call(EA,_);
        reg_jump(EA,_)
    ),
    arch.lra_register(Reg,_,_),
    !arch.lra_vector_register(Reg).

.decl lra_vector_call(EA:address)
lra_vector_call(EA):- lra_external_call(EA).
lra_vector_call(EA):- lra_instruction(EA), (indirect_call(EA); reg_call(EA,_)).
// A jump through a PLT stub or a GOT entry passes vector arguments like an
// external call; the indirect-jump rule above keeps only GPRs. plt_entry is the
// jump in each PLT stub, which an ordinary tail call (jmp foo@plt) reaches. It
// also covers stubs whose target the CFG follows into the module: an ifunc
// resolver (IRELATIVE) or a DSO's interposable definition. The rule below
// covers a GOT jump to an external symbol, such as the jmp *foo@GOTPCREL(%rip)
// that -fno-plt code emits.
lra_vector_call(EA):- plt_entry(EA,_).
lra_vector_call(EA):-
    refined_block_last_instruction(Block,EA),
    lra_instruction(EA),
    cfg_edge_to_symbol(Block,_,_,"true","branch").

lra_use(EA,Reg):-
    lra_vector_call(EA), arch.lra_vector_register(Reg), lra_abi_argument_register(Reg).

// A recovered jump table has explicit CFG targets. Only genuinely unresolved
// branches need the all-vector fallback. Unknown calls still have an ABI.
lra_use(EA,Reg):-
    refined_block_last_instruction(Block,EA), !arch.return(EA),
    cfg_edge_to_top(Block,_,"branch"), arch.lra_vector_register(Reg).

// This vector summary is specifically System V; do not infer Win64 saves.
lra_use(EA,Reg):-
    lra_instruction(EA), arch.lra_vector_register(Reg), !binary_format("ELF").

.decl lra_written(EA:address,Reg:register)

lra_written(EA,Reg):-
    lra_instruction(EA), vector_register_access(EA,Reg,"W"), arch.lra_vector_register(Reg).

lra_written(EA,Reg):-
    lra_instruction(EA),
    register_access(EA,RegIn,"W"),
    reg_map(RegIn,Reg),
    !arch.register_access_override(EA,Reg,"W",0),
    arch.lra_register_write_kills(RegIn,Reg).

lra_written(EA,Reg):-
    lra_instruction(EA),
    arch.register_access_override(EA,Reg,"W",1),
    arch.lra_register(Reg,_,_).

.decl lra_kill(EA:address,Reg:register)

lra_kill(EA,Reg):-
    lra_written(EA,Reg),
    !lra_use(EA,Reg).

lra_kill(EA,Reg):-
    lra_external_call(EA),
    arch.lra_caller_saved(Reg),
    !lra_use(EA,Reg).

.decl lra_live_out(EA:address,Reg:register)
.decl lra_live_in(EA:address,Reg:register)

lra_live_out(EA,Reg):-
    lra_next(EA,Next),
    lra_live_in(Next,Reg).

// Known callees and their returns carry vector dependencies just like GPRs:
// IPA register allocation can keep even ABI-volatile vectors across local
// calls. Only external/unknown calls use the ABI kill/argument summary above.

// A caller may observe preserved registers and ABI return values at a return.
lra_live_out(EA,Reg):-
    lra_instruction(EA),
    arch.return(EA),
    arch.lra_register(Reg,_,_),
    (
        !arch.lra_caller_saved(Reg);
        lra_abi_return_register(Reg)
    ).

// The condition flags have their own analysis below.
lra_live_in(EA,Reg):-
    lra_use(EA,Reg),
    !arch.lra_flag_register(Reg).

lra_live_in(EA,Reg):-
    lra_live_out(EA,Reg),
    !lra_kill(EA,Reg),
    !arch.lra_flag_register(Reg).

// Neither the x86-64 psABI nor AAPCS64 preserves the condition flags across a
// call. So a call kills them, and nothing is live into a return or into a
// transfer out of the module; known callees are not entered. Branches into
// another function's blocks still use their reads, and a transfer that the
// CFG does not resolve keeps every flag live.
.decl lra_flag_call(EA:address)

lra_flag_call(EA):-
    lra_instruction(EA),
    arch.call(EA,_).

.decl lra_flag_use(EA:address,Flag:symbol)

lra_flag_use(EA,Flag):-
    lra_instruction(EA),
    arch.lra_flag_access(EA,Flag,"R").

lra_flag_use(EA,Flag):-
    lra_instruction(EA),
    instruction(EA,_,_,Operation,_,_,_,_,_,_),
    arch.syscall_operation(Operation),
    arch.lra_flag(Flag).

.decl lra_flag_next(EA:address,Next:address)

lra_flag_next(EA,Next):-
    code_in_refined_block(EA,Block),
    next(EA,Next),
    code_in_refined_block(Next,Block).

lra_flag_next(EA,Dest):-
    refined_block_last_instruction(Block,EA),
    cfg_edge(Block,Dest,_,_,Type),
    (Type = "branch"; Type = "fallthrough"),
    !plt_block(Dest,_).

.decl lra_flag_successor(Block:address)

lra_flag_successor(Block):-
    cfg_edge(Block,_,_,_,Type),
    (Type = "branch"; Type = "fallthrough").

lra_flag_successor(Block):-
    cfg_edge_to_symbol(Block,_,_,_,"branch").

.decl lra_flag_unknown_successor(EA:address)

lra_flag_unknown_successor(EA):-
    refined_block_last_instruction(Block,EA),
    (
        cfg_edge_to_top(Block,_,"branch");
        cfg_edge_to_symbol(Block,_,_,"true","branch")
    ).

// A missing CFG edge is not evidence of a definition.
lra_flag_unknown_successor(EA):-
    refined_block_last_instruction(Block,EA),
    lra_instruction(EA),
    !arch.return(EA),
    !arch.call(EA,_),
    !lra_flag_successor(Block).

.decl lra_flag_live_out(EA:address,Flag:symbol)
.decl lra_flag_live_in(EA:address,Flag:symbol)

lra_flag_live_out(EA,Flag):-
    lra_flag_next(EA,Next),
    lra_flag_live_in(Next,Flag).

lra_flag_live_out(EA,Flag):-
    lra_flag_unknown_successor(EA),
    arch.lra_flag(Flag).

lra_flag_live_in(EA,Flag):-
    lra_flag_use(EA,Flag),
    !lra_flag_call(EA).

lra_flag_live_in(EA,Flag):-
    lra_flag_live_out(EA,Flag),
    !arch.lra_flag_access(EA,Flag,"W"),
    !lra_flag_call(EA).

.decl live_register(EA:address,Index:unsigned)
.output live_register

live_register(EA,Index):-
    lra_live_in(EA,Reg),
    arch.lra_register(Reg,Index,_).

live_register(EA,Index):-
    lra_flag_live_in(EA,_),
    arch.lra_flag_register(Reg),
    arch.lra_register(Reg,Index,_).
