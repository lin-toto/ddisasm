/**
This module performs symbolization.
It uses the results of several analysis:
 -use_def
 -value
 -data_access

Part of symbolization is pointer reattribution, that is detecting cases
where a number is the result of a symbol+constant. This is done in an
independent module 'pointer_reattribution' which also uses the results
of these analyses.

The data symbolization itself uses the following heuristics:

  - address_array: whether we have potential symbols evenly
    spaced. The more symbols the less likely they are all value
    collisions. We require at least 3 symbols evenly spaced to
    consider it an array.

  - preferred_data_access and data_access_patterns (from the data_access analysis):
    - if an address is accessed with the size of the pointer, it is more likely to be a pointer.
    - if an address is accessed with a size other than the size of the pointers, it is almost
      certainly not a pointer.

  - strings: if we have a pointer candidate in what seems to be a string,
    it is less likely to be a pointer.

  - aligned location: if a pointer candidate is aligned, it is more
    likely to be a pointer. Compilers usually (but not always) store
    pointers aligned.

This module also computes and symbol_minus_symbol.
*/

#include "empty_range.dl"
#include "noreturn.dl"
#include "use_def_analysis.dl"
#include "value_analysis.dl"
#include "boundary_value_analysis.dl"
#include "data_access_analysis.dl" // data_access_analysis uses predicates from here
#include "pointer_reattribution.dl"
#include "register_type_analysis.dl"

/**
Instruction at address 'EA' has a symbolic operand with value 'Value'.
'Value' is given as an address.
The field 'Index' identifies which operand is symbolic and 'Type' specifies
if the target is "data" or "code".
This predicate only supports symbolic expressions with one symbol and no
offset. For symbolic operands with offset see `moved_label`.
*/
.decl symbolic_operand(EA:address,Index:operand_index,Value:address,Type:symbol)

/**
There is a symbolic expression in the data at address 'EA' of size 'Size'
pointing to 'Value'. 'Value' is given as an address.
This predicate only supports symbolic expressions with one symbol
and no offset. For symbolic expressions in data with offset see
`moved_data_label` and for symbol-symbol expressions
see `symbol_minus_symbol`.
*/
.decl symbolic_data(EA:address,Size:unsigned,Value:address)

/**
There is a symbolic expression in data at address 'EA' of size 'Size' of the form:

'(Symbol2-Symbol1)*Scale+Offset'

Both symbols are given as addresses.
*/
.decl symbol_minus_symbol(EA:address,Size:unsigned,Symbol1:address,Symbol2:address,Scale:unsigned,Offset:number)

/**
 There is a symbolic expression at address 'EA' of size 'Size' of the form:

Symbol+Offset

 This symbolic expression corresponds to a relocation and the symbol
is referenced by name.
 */
.decl symbolic_expr_from_relocation(EA:address,Size:unsigned,Symbol:symbol,Offset:number,TargetEA:address)

/**
 There is a symbolic expression at address 'EA' of size 'Size' of the form:

(Symbol2-Symbol1)*Scale+Offset

This symbolic expression corresponds to a relocation and the symbol
is referenced by name.
 */
.decl symbol_minus_symbol_from_relocation(EA:address,Size:unsigned,Symbol1:symbol,Symbol2:symbol,Scale:unsigned,Offset:number)

// Not all ISAs have these
symbol_minus_symbol_from_relocation(0,0,"","",1,0):- false.

/**
There is a symbolic expression at address 'EA' of size 'Size' of the form:

'Symbol+Offset'

In contrast to `symbolic_operand` and `symbolic_data`, the symbol in this
predicate is referred by name. This allows us to include symbolic expressions
from relocations and to choose between multiple symbols at the same location.
This predicate captures all symbolic expressions from `symbolic_operand`,
`moved_label`, `symbolic_data`, `moved_data_label`,
and `symbolic_expr_from_relocation`.
*/
.decl symbolic_expr(EA:address,Size:unsigned,Symbol:symbol,Offset:number)
.output symbolic_expr

/**
There is a symbolic expression at address 'EA' of size 'Size' of the form:
  '(Symbol2-Symbol1)*Scale+Offset'
The symbols in this predicate are referred by name.
*/
.decl symbolic_expr_symbol_minus_symbol(EA:address,Size:unsigned,Symbol:symbol,Symbol2:symbol,Scale:unsigned,Offset:number)
.output symbolic_expr_symbol_minus_symbol

/**
Retain the address of a symbol selected by inference. Names alone do not
identify local definitions: distinct functions can have the same name, even
when that name was inferred (e.g. multiple CRT finalizers). Index is 1 for a
Symbol+Offset expression, and 1/2 in the order used by
symbolic_expr_symbol_minus_symbol. Absent entries retain name-based lookup
for expressions whose source only specifies a name, such as external imports.
*/
.decl symbolic_expr_symbol_address(EA:address,Index:unsigned,Symbol:symbol,SymbolEA:address)
.output symbolic_expr_symbol_address

/**
The symbolic operand at address 'EA' and 'Index' has a symbolic expression
attribute 'Attribute'. Note that some attributes may be inferred but not used,
if the corresponding `symbolic_operand` is not selected.
*/
.decl symbolic_operand_attribute(EA:address,Index:unsigned,Attribute:symbol)

symbolic_operand_attribute(0,0,""):- false.

/**
The symbolic expression at address 'EA' has a symbolic expression
attribute 'Attribute'.
*/
.decl symbolic_expr_attribute(ea:address,attribute:symbol)
.output symbolic_expr_attribute

/**
There is a symbolic expression in data at address 'EA' pointing to
a code block at address 'Val'.
*/
.decl code_pointer_in_data(EA:address,Val:address)

/**
The address 'Ea' needs to be labeled so it can be referred
in symbolic expressions.
*/
.decl labeled_ea(Ea:address)

// How data sections are divided into elements by labels or data objects
.decl data_object_boundary(EA:address)
.output data_object_boundary

// labels of un-initialized data
.decl bss_data(ea:address)
.output bss_data

////////////////////////////////////////////////////////////////////////////////////
// candidates of symbolic values in the code

.decl symbolic_operand_candidate(ea:address,operand_index:operand_index,Dest:address,Type:symbol)
.decl symbolic_operand_point(ea:address,operand_index:operand_index,points:number,why:symbol)
.decl symbolic_operand_total_points(ea:address,operand_index:operand_index,points:number) inline

// Symbolic operands that can occur in any binary type
symbolic_operand_candidate(EA,Op_index,Dest,Type):-
    code(EA),
    instruction_get_op(EA,Op_index,Op),
    (
        direct_call(EA,Dest),
        op_immediate(Op,_,_),
        arch.call(EA,Op_index)
        ;
        direct_jump(EA,Dest),
        op_immediate(Op,_,_),
        //ignore artificial jumps from loop prefixes
        !instruction_has_loop_prefix(EA),
        instruction_get_operation(EA,Operation),
        arch.jump_operation_op_index(Operation,Op_index)
        ;
        pc_relative_operand(EA,Op_index,Dest),
        UNUSED(Op)
        ;
        split_load_operand(EA,Op_index,Dest),
        UNUSED(Op)
    ),
    (
        code(Dest), Type = "code"
        ;
        data_segment(Begin,End),
        Dest >= Begin,
        Dest <= End,
        Type = "data"
    ).

// Symbolic operands that can only occur in executables
symbolic_operand_candidate(EA,Op_index,Dest_addr,Type):-
    binary_type("EXEC"),
    code(EA),
    instruction_get_op(EA,Op_index,Op),
    (
        op_immediate(Op,Dest,_),
        Dest_addr = as(Dest,address),
        !split_load_operand(EA,Op_index,_),
        !direct_call(EA,_),
        !direct_jump(EA,_)
        ;
        op_indirect(Op,_,_,_,_,Dest,_),
        Dest_addr = as(Dest,address),
        !pc_relative_operand(EA,Op_index,_),
        !split_load_operand(EA,Op_index,_)
    ),
    (
        code(Dest_addr), Type="code"
        ;
        data_segment(Begin,End),
        Dest_addr >= Begin, Dest_addr <= End,
        Type = "data"
    ).

// Deal with pie and relocatable code
symbolic_operand_candidate(EA,Op_index,Dest,Type):-
    !binary_type("EXEC"),
    !binary_type("REL"),
    code(EA),
    (
        instruction_immediate_offset(EA,Op_index,Offset,_)
        ;
        instruction_displacement_offset(EA,Op_index,Offset,_)
    ),
    relocation(EA+Offset,_,Symbol,Addend,SymbolIndex,_,_),
    symbol(SymbolAddr,_,SymbolType,_,_,_,_,SymbolIndex,Symbol),
    // Unnamed section symbols are resolved by symbolic_expr_from_relocation;
    // name-only matching would confuse every section with the same empty name.
    SymbolType != "SECTION",
    // Match the actual operand address, including the distance from a retained
    // x86 PC-relative relocation field to the end of its instruction. A raw
    // S+A candidate can otherwise invent a data reference just before the
    // real object and incorrectly truncate an adjacent relative jump table.
    relocation_adjustment_total(EA+Offset,Adjustment),
    Dest = as(as(SymbolAddr,number)+Addend+Adjustment,address),
    (
        code(Dest), Type = "code"
        ;
        data_segment(Begin,End),
        Dest >= Begin,
        Dest <= End,
        Type = "data"
    ).

// Handle PE base-relative relocations.
symbolic_operand_candidate(EA,Index,Dest,Type):-
    binary_format("PE"),
    code(EA),
    (
        instruction_immediate_offset(EA,Index,Offset,_),
        instruction_get_op(EA,Index,Op),
        op_immediate(Op,Value,_)
        ;
        instruction_displacement_offset(EA,Index,Offset,_),
        instruction_get_op(EA,Index,Op),
        op_indirect(Op,_,_,_,1,Value,_)
    ),
    relocation(EA+Offset,_,_,_,_,_,_),
    Dest = as(Value,address),
    (
        code(Dest),
        Type = "code"
        ;
        data_segment(Begin,End),
        Dest >= Begin, Dest <= End,
        Type = "data"
    ).

/////////////////////////////////////////////////////////////////
/// Final decision on symbolization of operands

// no decision needs to be made with pie code
symbolic_operand_point(EA,Index,10,"pie code"):-
    !binary_type("EXEC"),
    symbolic_operand_candidate(EA,Index,_,_).

symbolic_operand_point(EA,Imm_index,-1,"compared to non-address"):-
    cmp_immediate_to_reg(EA,Reg,Imm_index,_),
    reg_def_use.def_used(EA_def,Reg,EA,_),
    def_register_is_not_base_address(EA_def,Reg).

symbolic_operand_point(EA,Imm_index,-1,"immediate is bitmask"):-
    symbolic_operand_candidate(EA,Imm_index,_,_),
    instruction_get_op(EA,Imm_index,Op),
    op_immediate(Op,_,_),
    instruction_get_operation(EA,Operation),
    arch.logic_operation(Operation).

// An integer materialized by a move can accidentally equal an unlabeled
// address inside a data OBJECT.  A direct shift/rotate of that value is strong
// scalar evidence: Brotli, for example, shifts a packed hexadecimal nibble
// table before masking it.  The generic used-for-address relation can later
// follow that scalar through arithmetic into an indexed memory access, so use
// -2 to dominate its +1 without affecting relocations or exact target symbols.
symbolic_operand_point(EA,Imm_index,-2,
                       "shifted immediate points inside unlabeled data object"):-
    symbolic_operand_candidate(EA,Imm_index,Dest,"data"),
    op_immediate_and_reg(EA,Operation,Reg,Imm_index,_),
    arch.move_operation(Operation),
    reg_def_use.def_used(EA,Reg,ShiftEA,_),
    instruction_get_operation(ShiftEA,ShiftOperation),
    arch.shift_rotate_operation(ShiftOperation),
    !instruction_has_relocation(EA,_),
    defined_symbol(Beg,Size,"OBJECT",_,_,_,_,_,_),
    Size > 0,
    Dest > Beg,
    Dest < Beg+Size,
    !defined_symbol(Dest,_,_,_,_,_,_,_,_).

// A fragment belongs to a reconstructed address rather than being interpreted
// as an independent scalar. Architectures add their multi-instruction forms.
.decl reconstructed_address_fragment(EA:address,Index:operand_index)

reconstructed_address_fragment(EA,Index):-
    split_load_operand(EA,Index,_).

// Heuristic: treat values with >=20 trailing zero bits (0xFFFFF) as bitmasks.
//
// This threshold is empirical, not architectural. It was chosen to avoid
// misclassifying large immediates observed in bgpd (e.g., 0x800000)
// as addresses, while remaining more conservative than a 16-bit cutoff.
// Using 24 trailing zeros would miss this case; using 16 would increase
// false positives. If new binaries show misclassification in either direction,
// this threshold should be revisited.
//
symbolic_operand_point(EA,Imm_index,-1,"immediate may be bitmask"):-
    symbolic_operand_candidate(EA,Imm_index,_,_),
    // A recovered address fragment is not a standalone scalar immediate.
    // In particular, a zero LO12 tail must relocate if its page-aligned
    // target later moves within a page.
    !reconstructed_address_fragment(EA,Imm_index),
    instruction_get_op(EA,Imm_index,Op),
    op_immediate(Op,Imm,_),
    !direct_call(EA,_),
    !direct_jump(EA,_),
    !defined_symbol(as(Imm,address),_,_,_,_,_,_,_,_),
    !loaded_section(as(Imm,address),_,_),
    0 = (Imm band 0xFFFFF).

symbolic_operand_point(EA,Imm_index,-2,"point to exception section"):-
    symbolic_operand_candidate(EA,Imm_index,Dest,_),
    exception_section(Name),
    loaded_section(Base,End,Name),
    Base <= Dest, Dest < End,
    // Exact original symbols are independent evidence that the immediate is
    // an address.  In particular, crtbegin passes __EH_FRAME_BEGIN__ to the
    // frame-registration helpers; leaving that immediate numeric makes it
    // stale as soon as reconstruction moves .eh_frame.
    !defined_symbol(Dest,_,_,_,_,_,_,_,_).

symbolic_operand_point(EA,Imm_index,-1,"operated on logical operation result"):-
    op_immediate_and_reg(EA,_,Reg,Imm_index,_),
    !arch.jump(EA),
    reg_def_use.def_used(EA_def,Reg,EA,_),
    instruction_get_operation(EA_def,Operation),
    arch.logic_operation(Operation),
    !low_pass_filter(EA_def),
    !is_xor_reset(EA_def).

symbolic_operand_point(EA,1,-1,"result of LEA not base address"):-
    binary_format("ELF"),
    symbolic_operand_candidate(EA,1,_,_),
    !pc_relative_operand(EA,_,_),
    instruction(EA,_,_,"LEA",Op1,Op2,0,0,_,_),
    op_regdirect_contains_reg(Op2,Reg_def),
    op_indirect(Op1,_,_,_,_,_,_),
    def_register_is_not_base_address(EA,Reg_def).

symbolic_operand_point(EA,Op_index,-1,"moved/compared-with-different-size"):-
    symbolic_operand_candidate(EA,Op_index,_,_),
    instruction_get_op(EA,Op_index,Op),
    op_immediate(Op,_,_),
    instruction_get_op(EA,_,Op2),
    op_indirect(Op2,_,_,_,_,_,Size),
    arch.pointer_size(Pt_size),
    Size < Pt_size.

symbolic_operand_point(EA,Op_index,1,"used-for-address"):-
    symbolic_operand_candidate(EA,Op_index,_,_),
    instruction_get_op(EA,Op_index,Op),
    op_immediate(Op,_,_),
    def_used_for_address(EA,_,_).

symbolic_operand_total_points(EA,Operand,Points):-
    symbolic_operand_candidate(EA,Operand,_,_),
    (
        Points = sum X:{symbolic_operand_point(EA,Operand,X,_)};
        !symbolic_operand_point(EA,Operand,_,_), Points = 0
    ).

symbolic_operand(EA,Op_index,Value,Type):-
    symbolic_operand_candidate(EA,Op_index,Value,Type),
    symbolic_operand_total_points(EA,Op_index,Points),
    Points >= 0.

///////////////////////////////
// label candidates before moving
.decl labeled_data_candidate(EA:address)

labeled_data_candidate(EA):-
    !binary_isa("ARM"),
    symbol(EA,_,_,_,_,_,_,_,_).

labeled_data_candidate(EA):-
    symbolic_operand(_,_,EA,"data").

labeled_data_candidate(Val):-
    address_in_data_refined(EA,Val),
    arch.pointer_size(Pt_size),
    EA % Pt_size = 0.

// Detect symbol-symbol
////////////////////////////////////////////////////////////////////////

/**
A candidate for a symbol-symbol in data (includes jump tables and other relative symbols)
*/
.decl symbol_minus_symbol_candidate(EA:address,Size:unsigned,Symbol1:address,Symbol2:address,Scale:unsigned,Offset:number)

symbol_minus_symbol_candidate(EA,Size,Symbol1,Symbol2,as(Scale,unsigned),Offset):-
    relative_jump_table_entry(EA,_,Size,Reference,Dest,Scale,Offset),
    (
        Scale > 0, Symbol1 = Reference, Symbol2 = Dest;
        Scale < 0, Symbol1 = Dest, Symbol2 = Reference
        // Scale = 0 is nonsense.
    ),
    // If Symbol1 is zero, we have an absolute address.
    Symbol1 != 0.

// Displacements in indirect operands with address-value register
// need to be symbolized.
//
// E.g., `__memcpy_ssse3` in libc.so:
// 01:.L_1:
// 02:    leaq 40(%r9),%r9
// 03:    cmpq %rcx,%rdx
// 04:    movaps -12(%rsi),%xmm1
// 05:    jb .L_aade7
// 06:    leaq -7(%r9),%r9
// 07:.L_2:
// 08:    leaq -64(%rdx),%rdx
// 09:    notrack jmpq *%r9
// 10:    ud2
// 11:.L_3:
// 12:    prefetchnta -448(%rsi)
// 13:.L_4:
// 14:    movaps -28(%rsi),%xmm2
//
// .L_1 is one of the targets of a jump-table jump (jmp %9).
// Before line 2, R9's value is the address of itself.
// After line2 (.L_1 + 40 = .L_4), R9's value is .L_4.
// Note that the LEA instructions can be encoded in either 4 bytes or
// 7 bytes depending on assemblers.
// Therefore, it is important to symbolize the displacements.
//
// Similarly, before line 6, R9's value is the address of .L_4.
// After line 6 (.L_4 - 7 = .L3), R9's value is .L_3.
//
// The displacements in the indirect operands for both the LEAs
// at lines 2 and 6 need to be symbolized as
// leaq (.L_4 - .L_1)(%r9), %r9
// and
// leaq (.L_3 - .L_4)(%r9), %r9
// respectively.
//
symbol_minus_symbol_candidate(EA+DispOffset,DispSize,Symbol1,Symbol2,1,0):-
    binary_isa("X64"),
    code(EA),
    value_reg_address_before(EA,Reg,Address,_),
    !arch.pc_reg(Reg),
    !instruction_has_relocation(EA,_),
    instruction_get_op(EA,Index,Op),
    op_indirect_mapped(Op,"NONE",Reg,"NONE",1,Disp,_),
    Symbol1 = as(Address,address),
    Symbol2 = as(Address+Disp,address),
    instruction_displacement_offset(EA,Index,DispOffset,DispSize).


////////////////////////////////////////////////////////////////////////

/**
The address appearing at 'EA' is within a potential
`ascii_string` and therefore more likely to be spurious.
*/
.decl address_in_data_is_printable(EA:address)

address_in_data_is_printable(EA):-
    arch.pointer_size(Pt_size),
    ascii_string(EAString,End),
    address_in_data(EA,_),
    EAString <= EA, EA <= End - Pt_size.

/**
The address appearing at 'EA' overlaps with a potential
`ascii_string` and therefore more likely to be spurious.
*/
.decl address_in_data_overlaps_string(EA:address, EAString:address)

address_in_data_overlaps_string(EA, EAString):-
    ascii_string(EAString,End),
    address_in_data(EA,_),
    (
        EAString <= EA, EA < End;
        arch.pointer_size(Pt_size),
        EAString < EA+Pt_size, EA+Pt_size <= End
    ).

// address_in_data considers anything that points to the code region
// this refinement restricts that to the beginning of the final blocks
.decl address_in_data_refined(EA:address,Val:address)

// In a section with retained static relocations, an absolute pointer must
// have a relocation at its own source. An address-shaped scalar without one
// must remain a scalar. Coverage is per section, not inferred globally from
// a single retained table. ABI-typed function-pointer arrays are independent
// evidence, including binaries that do not retain static relocations.
.decl data_word_has_static_relocation_coverage(EA:address)

data_word_has_static_relocation_coverage(EA):-
    address_in_data(EA,_),
    elf_static_relocation_section(Name),
    loaded_section(Beg,End,Name),
    arch.pointer_size(Size),
    EA >= Beg, EA + Size <= End.

.decl abi_function_pointer_word(EA:address)

abi_function_pointer_word(EA):-
    address_in_data(EA,_),
    function_pointer_section(Name),
    loaded_section(Beg,End,Name),
    arch.pointer_size(Size),
    EA >= Beg, EA + Size <= End,
    (EA-Beg) % Size = 0.

.decl non_pointer_in_relocation_covered_data(EA:address)

non_pointer_in_relocation_covered_data(EA):-
    data_word_has_static_relocation_coverage(EA),
    !relocation(EA,_,_,_,_,_,_),
    !abi_function_pointer_word(EA).

address_in_data_refined(EA,Val):-
    binary_type("DYN"),
    address_in_data(EA,Val),
    relocation(EA,_,_,_,_,_,_),
    data_segment(Beg,End),
    Val >= Beg, Val <= End.

address_in_data_refined(EA,Val):-
    binary_type("DYN"),
    address_in_data(EA,Val),
    relocation(EA,_,_,_,_,_,_),
    block(Val).

address_in_data_refined(EA,Val):-
    (
        // Even in DYN case,
        // unlike x86, etc., MIPS does not use a traditional PLT.
        // All dynamic function calls are made through the GOT.
        // For symbols defined within the same DSO, GOT entries are fully
        // resolved at link time, while external symbols retain relocations
        // for runtime binding.
        binary_isa("MIPS")
        ;
        binary_type("EXEC")
    ),
    address_in_data(EA,Val),
    data_segment(Beg,End),
    Val >= Beg,
    Val <= End,
    data_segment(Beg0,End0),
    arch.pointer_size(PtSize),
    EA >= Beg0,
    EA + PtSize <= End0,
    !non_pointer_in_relocation_covered_data(EA).

address_in_data_refined(EA,Val):-
    (
        // Even in DYN case,
        // unlike x86, etc., MIPS does not use a traditional PLT.
        // All dynamic function calls are made through the GOT.
        // For symbols defined within the same DSO, GOT entries are fully
        // resolved at link time, while external symbols retain relocations
        // for runtime binding.
        binary_isa("MIPS")
        ;
        binary_type("EXEC")
    ),
    address_in_data(EA,Val),
    block(Val),
    data_segment(Beg0,End0),
    arch.pointer_size(PtSize),
    EA >= Beg0,
    EA + PtSize <= End0,
    !non_pointer_in_relocation_covered_data(EA).


.init address_in_data_refined_range=empty_range

address_in_data_refined_range.in_ea(EA):-
    address_in_data_refined(EA,_).

/**
Data-object analysis for string encodings.

Possible string of some 'Encoding' at interval ['EA','End').
*/
.decl string(EA:address,End:address,Encoding:symbol)
.output string

.decl string_candidate(EA:address,End:address,Encoding:symbol)

.decl string_candidate_refined(EA:address,End:address,Encoding:symbol)

string_candidate(EA,End,"ascii"):-
    ascii_string(Beg,End),
    (
      labeled_data_candidate(EA);
      preferred_data_access(_,_,EA)
    ),
    EA >= Beg, EA < End,
    data_segment(DataBeg,DataEnd),
    EA >= DataBeg,
    End <= DataEnd.

string_candidate(EA,End,"ascii"):-
    string_candidate(_,EA,"ascii"),
    ascii_string(EA,End),
    data_segment(DataBeg,DataEnd),
    EA >= DataBeg,
    End <= DataEnd.

/**
String at EA is followed by another string at Next.
*/
.decl subsequent_string_candidate(EA:address,Next:address)

subsequent_string_candidate(EA,Next):-
    string_candidate(EA,End,_),
    Next = min Begin : {
        string_candidate(Begin,_,_),
        Begin >= End
    },
    (
        End = Next
        ;
        Next - End < 8,
        padding_block_limit(Next)
    ).

/**
String candidate refinement projects candidate string references onto a compound
domain of "ascii" or "string" typed data objects, where "string" typed objects
are null-terminated.

Consider the compiler optimization of referencing a common substring:

    .L01:
            .ascii "xeon_ph"
    .L02:
            .string "i"

Referenced from `.L01' is the string "xeon_phi\0" referenced from `.L02' "i\0".
*/

string_candidate_refined(EA,End,"string"):-
    string_candidate(_,End,"ascii"),
    data_byte(End-1,0),
    EA = max EA : { string_candidate(EA,End,"ascii") }.

string_candidate_refined(EA,End,"ascii"):-
    string_candidate_refined(Tail,TailEnd,"string"),
    string_candidate(EA,TailEnd,"ascii"), EA < Tail,
    End = min Next : { string_candidate(Next,TailEnd,"ascii"), Next > EA }.

string(EA,End,Encoding):-
    data_object(EA,Size,"string"),
    string_candidate_refined(EA,End,Encoding),
    Size = End-EA.

///////////////////////////////////////////////////////////////////////////
.decl data_object_candidate(ea:address,size:unsigned,type:symbol)

.decl data_object_point(ea:address,size:unsigned,type:symbol,points:number,why:symbol)

.decl data_object_conflict(ea:address,size:unsigned,type:symbol,ea2:address,size2:unsigned,type2:symbol)

.decl discarded_data_object(ea:address,size:unsigned,type:symbol)

.decl data_object(ea:address,size:unsigned,type:symbol)

data_object_candidate(EA,Size,"symbol-symbol"):-
    symbol_minus_symbol_candidate(EA,Size,_,_,_,_).

data_object_candidate(EA,Pt_size,"symbol"):-
    arch.pointer_size(Pt_size),
    address_in_data_refined(EA,Dest),
    !impossible_jump_target(Dest).

data_object_candidate(EA,Size,"string"):-
    string_candidate_refined(EA,End,_),
    Size = End-EA.

data_object_candidate(EA,Size,"other"):-
    preferred_data_access(EA,Size,_),
    !address_in_data_refined(EA,_),
    !symbol_minus_symbol_candidate(EA,Size,_,_,_,_).

///////////////////////////////////////////////////////////////////////////////////////////
// Heuristic: If there are at least 3 consecutive addresses
//  we consider that we found an array of addresses.
// Do not join candidates across either symbol starts or the declared end of
// an original OBJECT.  The latter is not itself a label, but is an equally
// strong source-layout boundary.  Without it, an address-shaped scalar in the
// final bytes of one object can become the first member of an unrelated,
// regularly spaced pointer sequence that follows the object.
.decl original_object_boundary(EA:address)

original_object_boundary(ObjectBeg+ObjectSize):-
    defined_symbol(ObjectBeg,ObjectSize,"OBJECT",_,_,_,_,_,_),
    ObjectSize > 0.

.decl after_address_in_data(EA:address,EA_next:address)

after_address_in_data(EA,EA+Pt_size):-
    address_in_data_refined(EA,_),
    arch.pointer_size(Pt_size),
    data_byte(EA+Pt_size,_),
    !labeled_data_candidate(EA+Pt_size),
    !original_object_boundary(EA+Pt_size).

after_address_in_data(EA,EA_aux+1):-
    after_address_in_data(EA,EA_aux),
    !address_in_data_refined(EA_aux,_),
    data_byte(EA_aux+1,_),
    !labeled_data_candidate(EA_aux+1),
    !original_object_boundary(EA_aux+1).

.decl next_address_in_data(EA:address,EA_next:address)


next_address_in_data(EA,EA_next):-
    address_in_data_refined(EA,_),
    after_address_in_data(EA,EA_next),
    address_in_data_refined(EA_next,_).

/**
Auxiliary predicate to compute `address_array`.
*/
.decl address_array_aux(EA:address,Distance:unsigned,type:symbol,InitialEA:address)

// The base cases check for three consecutive pointers.
address_array_aux(EA,Diff,"code",EA):-
    address_in_data_refined(EA,Dest1),code(Dest1),
    (
      binary_format("PE");
      arch.pointer_size(Pt_size),
      EA % Pt_size = 0
    ),
    next_address_in_data(EA,EA_next),
    Diff = EA_next-EA,
    // Make sure EA contains the FIRST evenly spaced pointer
    // of the sequence. Either there is no previous
    // pointer at the right distance or it does not point
    // to code.
    (
        !next_address_in_data(EA-Diff,EA)
        ;
        next_address_in_data(EA-Diff,EA),
        address_in_data_refined(EA-Diff,Dest_prev),
        !code(Dest_prev)

    ),
    address_in_data_refined(EA+Diff,Dest2),code(Dest2),
    next_address_in_data(EA+Diff,EA+(2*Diff)),
    address_in_data_refined(EA+(2*Diff),Dest3),code(Dest3).


address_array_aux(EA,Diff,"data",EA):-
    address_in_data_refined(EA,Dest1),
    arch.pointer_size(Pt_size),
    EA % Pt_size = 0,
    next_address_in_data(EA,EA_next),
    Diff = EA_next-EA,
    data_segment(Begin,End),
    // A data pointer may target uninitialized storage.  Requiring data_byte
    // at the destination incorrectly excludes .bss, even though its extent
    // is known.  The source words still come from initialized data, and all
    // three destinations must lie inside the same (half-open) data segment.
    Begin <= Dest1, Dest1 < End,
    // Make sure EA contains the FIRST evenly spaced pointer
    // of the sequence. Either there is no previous
    // pointer or it points outside the data segment.
    (
        !next_address_in_data(EA-Diff,EA)
        ;
        next_address_in_data(EA-Diff,EA),
        address_in_data_refined(EA-Diff,Dest_prev),
        (Dest_prev < Begin ; Dest_prev >= End)
    ),
    // A pointer array pointing to data, should point to the same section
    address_in_data_refined(EA+Diff,Dest2),
    next_address_in_data(EA+Diff,EA+(2*Diff)),
    address_in_data_refined(EA+(2*Diff),Dest3),
    Begin <= Dest2, Dest2 < End,
    Begin <= Dest3, Dest3 < End.


address_array_aux(EA+Diff,Diff,"code",InitialEA):-
    address_array_aux(EA,Diff,"code",InitialEA),
    next_address_in_data(EA,EA+Diff),
    address_in_data_refined(EA+Diff,Dest),code(Dest).

address_array_aux(EA+Diff,Diff,"data",InitialEA):-
    address_array_aux(EA,Diff,"data",InitialEA),
    address_in_data_refined(EA,Dest1),
    next_address_in_data(EA,EA+Diff),
    address_in_data_refined(EA+Diff,Dest2),
    data_segment(Begin,End),
    // a pointer array pointing to data, should point to the same section
    Begin <= Dest1, Dest1 < End,
    Begin <= Dest2, Dest2 < End.

/**
This predicate is used for the symbolization heuristics. The
pointer candidate at address 'EA' belongs to a sequence of
evenly spaced pointer candidates starting at address 'InitialEA'.
The space between pointers is 'Distance'. This sequence
has at least three pointers. All the pointers in a sequence
either point to code or to the same `data_segment`.
*/
.decl address_array(EA:address,Distance:unsigned,InitialEA:address)

address_array(EA,Distance,InitialEA):-
    address_array_aux(EA,Distance,_,InitialEA).

.init address_array_range=empty_range

address_array_range.in_ea(EA):-
    address_array(EA,_,_).


//////////////////////////////////////////////////////////////////////////////////
// Final decision on symbolization of data

data_object_point(EA,Pt_size,Type,-2,"data object bias"):-
    data_object_candidate(EA,Pt_size,Type).

// Exception sections are symbolized directly without heuristics.
// Any candidates detected here are considered spurious.
data_object_point(EA,Size,Type,-100,"in-exception-section"):-
    data_object_candidate(EA,Size,Type),
    exception_section(Name),
    loaded_section(Base,End,Name),
    EA >= Base, EA < End.

data_object_point(EA,8,"symbol-symbol",5,"quad symbol-symbol"):-
    data_object_candidate(EA,8,"symbol-symbol").

data_object_point(EA,Size,"symbol-symbol",4,"symbol-symbol"):-
    data_object_candidate(EA,Size,"symbol-symbol"),
    Size <= 4.

// Pointer array heuristic
data_object_point(EA,Pt_size,"symbol",3,"pointer array"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_array(EA,Distance,_),
    Distance % Pt_size = 0.

// a pointer array should point to elements of the same type
// the pointed elements get points if they are all the same type
data_object_point(EA,Size,Type,2,"pointed by pointer array"),
data_object_point(EA2,Size2,Type,2,"pointed by pointer array"),
data_object_point(EA3,Size3,Type,2,"pointed by pointer array"),
data_object_point(EA4,Size4,Type,2,"pointed by pointer array"):-
    address_array(EA_array,Distance,InitialEA),
    address_in_data(EA_array,EA),
    data_object_candidate(EA,Size,Type),

    address_array(EA_array+Distance,Distance,InitialEA),
    address_in_data(EA_array+Distance,EA2),
    data_object_candidate(EA2,Size2,Type),

    address_array(EA_array+2*Distance,Distance,InitialEA),
    address_in_data(EA_array+2*Distance,EA3),
    data_object_candidate(EA3,Size3,Type),

    address_array(EA_array+3*Distance,Distance,InitialEA),
    address_in_data(EA_array+3*Distance,EA4),
    data_object_candidate(EA4,Size4,Type).

// data access heuristic
data_object_point(EA,Pt_size,"symbol",5,"data access"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    (
        preferred_data_access(EA,Pt_size,_);
        preferred_data_access(EA,0,_)
    ).

// A pointer-width window inside a densely accessed narrower-scalar table can
// accidentally decode as an address.  For example, two adjacent uint32_t DES
// table entries form one aligned uint64_t value on a 64-bit executable; if
// that value happens to equal a linked symbol address, relayout corrupts both
// scalar entries.  A propagated sub-pointer-width access is direct evidence
// for the source field boundary.  A second clause below uses the same evidence
// at OBJECT scope when inferred data limits stop local propagation.  Reject
// only otherwise-unanchored windows so relocations, exact source labels,
// pointer-width accesses, and real pointer arrays continue to win.
.decl unanchored_pointer_window_with_narrow_access(
          EA:address,Pt_size:unsigned)

unanchored_pointer_window_with_narrow_access(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    preferred_data_access(EA,AccessSize,_),
    AccessSize > 0,
    AccessSize < Pt_size,
    Pt_size % AccessSize = 0,
    !defined_symbol(EA,_,_,_,_,_,_,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

data_object_point(EA,Pt_size,"symbol",-10,
                  "narrow scalar access defines smaller fields"):-
    unanchored_pointer_window_with_narrow_access(EA,Pt_size).

// if we conflict with several other candidates we reduce the points
data_object_point(EA,Pt_size,"symbol",-2,"multiple conflict"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    data_object_conflict(EA,Pt_size,"symbol",EA2,_,"other"),
    data_object_conflict(EA,Pt_size,"symbol",EA3,_,"other"),
    EA2 != EA3.

.decl label_conflict(EA:address,Size:unsigned,Kind:symbol)

label_conflict(EA,Pt_size,"symbol"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    labeled_data_candidate(EA2),
    EA2 > EA, EA2 < EA+Pt_size.

data_object_point(EA,Pt_size,"symbol",1,"no label conflicts"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    !label_conflict(EA,Pt_size,"symbol").

data_object_point(EA,Pt_size,"symbol",2,"aligned"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    EA % Pt_size = 0.

// A pointer-width window can begin in the final bytes of another candidate
// and accidentally decode as an address.  An exact target symbol is strong
// destination evidence, but it says nothing about the source-field boundary.
// When such a candidate starts strictly inside a naturally aligned
// pointer-width candidate, apply a source-alignment tie-break.  The modest
// penalty leaves relocations, demonstrated data accesses, and pointer-array
// structure strong enough to retain genuine packed pointers; it only makes a
// weak interior window lose to the aligned field that contains its start.
data_object_point(EA,Pt_size,"symbol",-4,
                  "starts inside aligned pointer candidate"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    EA % Pt_size != 0,
    data_object_candidate(AlignedEA,Pt_size,"symbol"),
    AlignedEA % Pt_size = 0,
    AlignedEA < EA,
    EA < AlignedEA+Pt_size.

// A fully linked executable may no longer retain a relocation for a pointer
// stored in data.  If its value is exactly the start of an original symbol,
// that symbol is independent address evidence.  This also resolves the
// otherwise ambiguous case where the low bytes of the address form a short
// NUL-terminated printable string: the pointer candidate must win over the
// coincidental string candidate so that relayout updates the stored address.
// Keep this weaker than an explicit relocation, and require an exact target
// rather than an unlabeled object interior.  Exact destination identity alone
// does not defeat a genuine source string: short text such as "mac" can itself
// encode a valid address.  In that conflict, require independent source-side
// pointer provenance (a label, relocation, pointer-width/unknown access, or
// pointer-array shape).  Structured runtime/linker sections are excluded as
// sources because their fixed-width scalar records can contain the same
// accidental exact-address bit patterns.
.decl source_in_special_data_section(EA:address,Size:unsigned)

source_in_special_data_section(EA,Size):-
    data_object_candidate(EA,Size,_),
    special_data_section(Name),
    loaded_section(Beg,End,Name),
    EA >= Beg,
    EA+Size <= End.

data_object_point(EA,Pt_size,"symbol",5,"points to exact symbol"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    defined_symbol(Dest,_,Type,_,_,_,_,_,_),
    Type != "SECTION",
    !source_in_special_data_section(EA,Pt_size),
    (
        !string_candidate_refined(EA,_,_)
        ;
        defined_symbol(EA,_,_,_,_,_,_,_,_)
        ;
        relocation(EA,_,_,_,_,_,_)
        ;
        preferred_data_access(EA,Pt_size,_)
        ;
        preferred_data_access(EA,0,_)
        ;
        address_array(EA,_,_)
    ).

// Exact identity at the destination cannot by itself establish an unaligned
// source-field boundary.  In particular, a pointer-width window that straddles
// two naturally aligned scalar slots, or starts in the tail of an object and
// continues through its padding, can accidentally decode as the address of a
// real function or object.  Penalize candidates whose start is inside an
// original nonzero OBJECT and has no independent source provenance: no source
// symbol, relocation, pointer-width access, or pointer-array shape.  A window
// crossing the declared end is even less likely to be a genuine field, so it
// deliberately receives the same penalty as one fully contained in the object.
// The -5 score turns the otherwise isolated exact-symbol score of +4 into -1;
// genuine packed pointers remain recoverable through any of those independent
// anchors (and stronger structural recovery rules remain additive).
.decl unanchored_unaligned_pointer_starting_in_object(
          EA:address,Pt_size:unsigned)

unanchored_unaligned_pointer_starting_in_object(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    EA % Pt_size != 0,
    defined_symbol(SrcBeg,SrcSize,"OBJECT",_,_,_,_,_,_),
    SrcSize > 0,
    EA >= SrcBeg,
    EA < SrcBeg+SrcSize,
    !defined_symbol(EA,_,_,_,_,_,_,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

data_object_point(EA,Pt_size,"symbol",-5,
                  "unanchored unaligned source inside object"):-
    unanchored_unaligned_pointer_starting_in_object(EA,Pt_size).

// The converse source-boundary collision begins in anonymous padding and
// crosses the start of a named object.  On little-endian executables, the
// padding plus the object's first scalar bytes can accidentally equal the
// exact address of an unrelated symbol.  Re-emitting that window as a pointer
// would then overwrite bytes owned by the named object when layout changes.
// An original nonzero OBJECT start is strong source-boundary evidence, but it
// must not suppress a genuine packed field that has its own relocation,
// pointer-width access, source label, or pointer-array structure.
.decl unanchored_unaligned_pointer_crossing_object_start(
          EA:address,Pt_size:unsigned)

unanchored_unaligned_pointer_crossing_object_start(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    EA % Pt_size != 0,
    defined_symbol(ObjectBeg,ObjectSize,"OBJECT",_,_,_,_,_,_),
    ObjectSize > 0,
    ObjectBeg > EA,
    ObjectBeg < EA+Pt_size,
    !defined_symbol(EA,_,_,_,_,_,_,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

data_object_point(EA,Pt_size,"symbol",-5,
                  "unanchored source crosses object start"):-
    unanchored_unaligned_pointer_crossing_object_start(EA,Pt_size).

// Consecutive relative jump-table entries are scalar offsets, not storage for
// an overlapping pointer-width field.  Their byte windows can nevertheless
// decode as an exact code address: two adjacent 32-bit switch offsets may, for
// example, form the little-endian value of a real function symbol when read
// starting in the middle of the first entry.  Reject an otherwise unanchored
// pointer candidate when its source window overlaps at least two entries of
// the same smaller-entry table.  A relocation, exact pointer-width load, or
// established pointer array remains independent source provenance in case a
// tentative jump-table analysis overlaps genuine packed data.
.decl unanchored_pointer_overlapping_relative_jump_table(
          EA:address,Pt_size:unsigned)

unanchored_pointer_overlapping_relative_jump_table(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    relative_jump_table_entry(JumpEA1,TableStart,EntrySize,_,_,_,_),
    relative_jump_table_entry(JumpEA2,TableStart,EntrySize,_,_,_,_),
    EntrySize < Pt_size,
    JumpEA1 != JumpEA2,
    JumpEA1 < EA+Pt_size,
    EA < JumpEA1+EntrySize,
    JumpEA2 < EA+Pt_size,
    EA < JumpEA2+EntrySize,
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

data_object_point(EA,Pt_size,"symbol",-10,
                  "overlaps multiple relative jump-table entries"):-
    unanchored_pointer_overlapping_relative_jump_table(EA,Pt_size).

// A raw integer can also happen to equal an address strictly inside a known
// data object.  Exact target symbols are independent pointer evidence, but an
// unlabeled interior match on its own is weak: the usual bias, source
// alignment, and lack of label conflicts otherwise give it a positive score.
// Keep this penalty small so pointer-sized accesses, pointer arrays, and
// relocations continue to retain genuine interior data pointers.
.decl unlabeled_interior_data_object_address(EA:address)

unlabeled_interior_data_object_address(EA):-
    address_in_data_refined(_,EA),
    defined_symbol(Beg,Size,"OBJECT",_,_,_,_,_,_),
    Size > 0,
    EA > Beg,
    EA < Beg+Size,
    !defined_symbol(EA,_,_,_,_,_,_,_,_).

data_object_point(EA,Pt_size,"symbol",-2,"points inside unlabeled data object"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    unlabeled_interior_data_object_address(Dest).

// Arrays of records often contain the same pointer field at a fixed stride.
// Interleaved fields can prevent the ordinary address-array heuristic from
// recognizing that evidence.  Recover only a strong five-member pattern
// contained in one nonzero source OBJECT and pointing inside one nonzero
// destination OBJECT.  Original symbol and nested-object boundaries split
// runs, and extension is allowed only through exact next members (no holes).
.decl interior_object_pointer(EA:address,SrcBeg:address,SrcEnd:address,
                              DestBeg:address,DestEnd:address)

interior_object_pointer(EA,SrcBeg,SrcBeg+SrcSize,DestBeg,DestBeg+DestSize):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    EA % Pt_size = 0,
    defined_symbol(SrcBeg,SrcSize,"OBJECT",_,_,_,_,_,_),
    SrcSize > 0,
    EA >= SrcBeg,
    EA+Pt_size <= SrcBeg+SrcSize,
    defined_symbol(DestBeg,DestSize,"OBJECT",_,_,_,_,_,_),
    DestSize > 0,
    Dest > DestBeg,
    Dest < DestBeg+DestSize,
    !defined_symbol(Dest,_,_,_,_,_,_,_,_).

// Assign each pointer candidate to the range starting at its nearest original
// symbol or nonempty OBJECT end. Equal ranges mean no boundary lies in (A,B],
// without materializing every pair of candidates crossed by a boundary.
.decl pointer_source_boundary(Boundary:address)

// Addresses are unsigned, so zero bounds the range before the first symbol.
pointer_source_boundary(0).

pointer_source_boundary(Boundary):-
    defined_symbol(Boundary,_,_,_,_,_,_,_,_).

pointer_source_boundary(Beg+Size):-
    defined_symbol(Beg,Size,"OBJECT",_,_,_,_,_,_),
    Size > 0.

.decl pointer_candidate_source_range(EA:address,Begin:address)

pointer_candidate_source_range(EA,Begin):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    Begin = max Boundary : {
        pointer_source_boundary(Boundary),
        Boundary <= EA
    }.

// Compute the successor before joining source ranges, so the minimum is not
// evaluated again for every candidate sharing a range.
.decl interior_object_pointer_successor(EA:address,Next:address,
                                        SrcBeg:address,SrcEnd:address,
                                        DestBeg:address,DestEnd:address)

interior_object_pointer_successor(EA,Next,SrcBeg,SrcEnd,DestBeg,DestEnd):-
    interior_object_pointer(EA,SrcBeg,SrcEnd,DestBeg,DestEnd),
    Next = min Candidate : {
        interior_object_pointer(Candidate,SrcBeg,SrcEnd,DestBeg,DestEnd),
        Candidate > EA
    }.

.decl next_interior_object_pointer(EA:address,Next:address,
                                   SrcBeg:address,SrcEnd:address,
                                   DestBeg:address,DestEnd:address)

next_interior_object_pointer(EA,Next,SrcBeg,SrcEnd,DestBeg,DestEnd):-
    interior_object_pointer_successor(EA,Next,SrcBeg,SrcEnd,DestBeg,DestEnd),
    pointer_candidate_source_range(EA,Range),
    pointer_candidate_source_range(Next,Range).

.decl interior_object_pointer_seed(EA:address,Stride:unsigned,
                                   SrcBeg:address,SrcEnd:address,
                                   DestBeg:address,DestEnd:address)

interior_object_pointer_seed(EA,Stride,SrcBeg,SrcEnd,DestBeg,DestEnd):-
    arch.pointer_size(Pt_size),
    next_interior_object_pointer(EA,EA1,SrcBeg,SrcEnd,DestBeg,DestEnd),
    Stride = EA1-EA,
    Stride >= 4*Pt_size,
    Stride % Pt_size = 0,
    next_interior_object_pointer(EA1,EA2,SrcBeg,SrcEnd,DestBeg,DestEnd),
    EA2 = EA1+Stride,
    next_interior_object_pointer(EA2,EA3,SrcBeg,SrcEnd,DestBeg,DestEnd),
    EA3 = EA2+Stride,
    next_interior_object_pointer(EA3,EA4,SrcBeg,SrcEnd,DestBeg,DestEnd),
    EA4 = EA3+Stride,
    EA4+Pt_size <= SrcEnd.

.decl repeated_interior_object_pointer_member(
          EA:address,Stride:unsigned,SrcBeg:address,SrcEnd:address,
          DestBeg:address,DestEnd:address)

repeated_interior_object_pointer_member(
          EA,Stride,SrcBeg,SrcEnd,DestBeg,DestEnd):-
    interior_object_pointer_seed(
        EA,Stride,SrcBeg,SrcEnd,DestBeg,DestEnd).

repeated_interior_object_pointer_member(
          Next,Stride,SrcBeg,SrcEnd,DestBeg,DestEnd):-
    repeated_interior_object_pointer_member(
        EA,Stride,SrcBeg,SrcEnd,DestBeg,DestEnd),
    next_interior_object_pointer(
        EA,Next,SrcBeg,SrcEnd,DestBeg,DestEnd),
    Next = EA+Stride.

.decl repeated_interior_object_pointer(EA:address)

repeated_interior_object_pointer(EA):-
    repeated_interior_object_pointer_member(EA,_,_,_,_,_).

data_object_point(EA,Pt_size,"symbol",2,
                  "repeated strided interior-object pointer"):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    repeated_interior_object_pointer(EA).

// A short or isolated record-field run may sit outside the five-member
// repeated-pointer chain even though the surrounding descriptor table gives
// independent structural evidence.  Recover the candidate only when the
// u32 immediately before it is a positive byte length and a data-pointer
// array member two or three records later points exactly that many bytes
// farther into the same destination OBJECT.  The seed establishes the record
// stride; this rule neither propagates recursively nor crosses a source
// symbol/OBJECT boundary.
.decl length_delimited_interior_pointer(EA:address)

length_delimited_interior_pointer(EA):-
    interior_object_pointer(EA,SrcBeg,SrcEnd,DestBeg,DestEnd),
    address_in_data_refined(EA,Dest),
    EA >= SrcBeg+4,
    data_uword(EA-4,4,Length),
    Length > 0,
    interior_object_pointer_seed(
        _,Stride,SrcBeg,SrcEnd,DestBeg,DestEnd),
    interior_object_pointer(
        Next,SrcBeg,SrcEnd,DestBeg,DestEnd),
    address_in_data_refined(Next,NextDest),
    address_array_aux(Next,_,"data",_),
    (
        Next = EA+2*Stride
        ;
        Next = EA+3*Stride
    ),
    NextDest = Dest+Length,
    NextDest > Dest,
    pointer_candidate_source_range(EA,Range),
    pointer_candidate_source_range(Next,Range).

data_object_point(EA,Pt_size,"symbol",2,
                  "length-delimited interior-object pointer"):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    length_delimited_interior_pointer(EA).

// Compiler constant pools frequently contain arrays of descriptor records in
// which a pointer is followed by a pointer-width byte length.  Four records
// are sufficient independent evidence when the first target is the exact
// start of one nonzero OBJECT and both source and destination advance at fixed
// strides.  This complements the five-member interior-pointer rule above:
// the source pool need not have its own OBJECT symbol, and exact object-base
// evidence anchors the shorter run.  Positive lengths must remain within the
// destination object, and original source boundaries split runs.
.decl sized_object_pointer(EA:address,Dest:address,
                           DestBeg:address,DestEnd:address)

sized_object_pointer(EA,Dest,DestBeg,DestBeg+DestSize):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    EA % Pt_size = 0,
    data_uword(EA+Pt_size,Pt_size,Length),
    Length > 0,
    defined_symbol(DestBeg,DestSize,"OBJECT",_,_,_,_,_,_),
    DestSize > 0,
    Dest >= DestBeg,
    Dest < DestBeg+DestSize,
    Length <= DestBeg+DestSize-Dest.

.decl strided_sized_object_pointer_seed(
          EA:address,Stride:unsigned,DestStride:unsigned,
          SrcBeg:address,SrcEnd:address,DestBeg:address,DestEnd:address)

strided_sized_object_pointer_seed(
          EA,Stride,DestStride,SrcBeg,SrcEnd,DestBeg,DestEnd):-
    arch.pointer_size(Pt_size),
    sized_object_pointer(EA,DestBeg,DestBeg,DestEnd),
    sized_object_pointer(EA1,Dest1,DestBeg,DestEnd),
    EA1 > EA,
    Stride = EA1-EA,
    Stride >= 4*Pt_size,
    Stride % Pt_size = 0,
    Dest1 > DestBeg,
    DestStride = Dest1-DestBeg,
    sized_object_pointer(EA1+Stride,Dest1+DestStride,DestBeg,DestEnd),
    sized_object_pointer(EA1+2*Stride,Dest1+2*DestStride,DestBeg,DestEnd),
    regular_data_section(SrcName),
    loaded_section(SrcBeg,SrcEnd,SrcName),
    EA >= SrcBeg,
    EA+3*Stride+2*Pt_size <= SrcEnd,
    pointer_candidate_source_range(EA,Range),
    pointer_candidate_source_range(EA+3*Stride,Range).

.decl strided_sized_object_pointer_member(EA:address)

strided_sized_object_pointer_member(EA):-
    strided_sized_object_pointer_seed(EA,_,_,_,_,_,_).

strided_sized_object_pointer_member(EA+Stride):-
    strided_sized_object_pointer_seed(EA,Stride,_,_,_,_,_).

strided_sized_object_pointer_member(EA+2*Stride):-
    strided_sized_object_pointer_seed(EA,Stride,_,_,_,_,_).

strided_sized_object_pointer_member(EA+3*Stride):-
    strided_sized_object_pointer_seed(EA,Stride,_,_,_,_,_).

// A second pointer/length field can be interleaved in the same four records.
// Retain it only when all four members preserve both the established record
// stride and their own constant offset within the destination object.  The
// field and its length must fit before the next record.
.decl parallel_strided_sized_object_pointer_seed(
          ParallelEA:address,Stride:unsigned)

parallel_strided_sized_object_pointer_seed(ParallelEA,Stride):-
    arch.pointer_size(Pt_size),
    strided_sized_object_pointer_seed(
        EA,Stride,DestStride,_,SrcEnd,DestBeg,DestEnd),
    sized_object_pointer(ParallelEA,ParallelDest,DestBeg,DestEnd),
    ParallelEA > EA,
    ParallelEA < EA+Stride,
    FieldOffset = ParallelEA-EA,
    FieldOffset >= 2*Pt_size,
    FieldOffset % Pt_size = 0,
    FieldOffset+2*Pt_size <= Stride,
    ParallelDest > DestBeg,
    sized_object_pointer(
        ParallelEA+Stride,ParallelDest+DestStride,DestBeg,DestEnd),
    sized_object_pointer(
        ParallelEA+2*Stride,ParallelDest+2*DestStride,DestBeg,DestEnd),
    sized_object_pointer(
        ParallelEA+3*Stride,ParallelDest+3*DestStride,DestBeg,DestEnd),
    ParallelEA+3*Stride+2*Pt_size <= SrcEnd,
    pointer_candidate_source_range(EA,Range),
    pointer_candidate_source_range(ParallelEA+3*Stride,Range).

.decl parallel_strided_sized_object_pointer_member(EA:address)

parallel_strided_sized_object_pointer_member(ParallelEA):-
    parallel_strided_sized_object_pointer_seed(ParallelEA,_).

parallel_strided_sized_object_pointer_member(ParallelEA+Stride):-
    parallel_strided_sized_object_pointer_seed(ParallelEA,Stride).

parallel_strided_sized_object_pointer_member(ParallelEA+2*Stride):-
    parallel_strided_sized_object_pointer_seed(ParallelEA,Stride).

parallel_strided_sized_object_pointer_member(ParallelEA+3*Stride):-
    parallel_strided_sized_object_pointer_seed(ParallelEA,Stride).

data_object_point(EA,Pt_size,"symbol",2,
                  "strided pointer/length descriptor record"):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    (
        strided_sized_object_pointer_member(EA)
        ;
        parallel_strided_sized_object_pointer_member(EA)
    ).

// A dense indexed load whose element is narrower than a native pointer is an
// object-level scalar-layout witness.  Keep the access width explicit: only
// pointer windows aligned to the demonstrated scalar stride are classified by
// this evidence.
.decl subpointer_width_dense_access(
          AccessBase:address,AccessSize:unsigned,
          Pt_size:unsigned,LoadEA:address)

subpointer_width_dense_access(AccessBase,AccessSize,Pt_size,LoadEA):-
    arch.pointer_size(Pt_size),
    AccessSize > 0,
    AccessSize < Pt_size,
    Pt_size % AccessSize = 0,
    data_access_pattern_candidate_refined(
        AccessBase,AccessSize,Mult,LoadEA),
    Mult = as(AccessSize,number),
    dap_max_mult(AccessBase,AccessSize,Mult),
    arch.load(LoadEA,_,_,_,_,_,_,_).

// An indexed access can still establish a narrow scalar layout when exact
// value analysis cannot fold the index to a conventional DAP.  In particular,
// preserve a range introduced by a low-pass mask and propagated through the
// existing move/arithmetic limit analysis.  Keep both bounds tied to the same
// final definition so limits from unrelated control-flow paths are not mixed.
.decl bounded_subpointer_width_access(
          AccessBeg:address,AccessEnd:address,AccessSize:unsigned,
          Pt_size:unsigned,LoadEA:address)

bounded_subpointer_width_access(
        AccessBeg,AccessEnd,AccessSize,Pt_size,LoadEA):-
    arch.pointer_size(Pt_size),
    AccessSize > 0,
    AccessSize < Pt_size,
    Pt_size % AccessSize = 0,
    data_access(
        LoadEA,OpIndex,"NONE",BaseReg,IndexReg,
        Scale,MemOffset,AccessSize),
    // This is field-width evidence, not a memory-to-register value transfer.
    // A bounded XOR/ADD/CMP memory operand reads the same narrow scalar cells
    // as MOV. Keep arch.load's stronger value-analysis contract unchanged.
    (
        arch.load(LoadEA,OpIndex,_,_,BaseReg,IndexReg,Scale,MemOffset)
        ;
        instruction_get_src_op(LoadEA,OpIndex,_)
    ),
    reg_nonnull(IndexReg,IndexReg_nn),
    Scale = as(AccessSize,number),
    value_reg_at_operand(
        LoadEA,OpIndex,BaseReg,_,0,BaseAddress,"complete"),
    last_value_reg_limit(
        BoundFrom,LoadEA,IndexReg_nn,IndexMin,"MIN",BoundSteps),
    last_value_reg_limit(
        BoundFrom,LoadEA,IndexReg_nn,IndexMax,"MAX",BoundSteps),
    BaseAddress >= 0,
    IndexMin >= 0,
    IndexMax >= IndexMin,
    AccessBeg = as(
        BaseAddress+MemOffset+IndexMin*Scale,address),
    AccessEnd = as(
        BaseAddress+MemOffset+IndexMax*Scale+
        as(AccessSize,number),address),
    AccessEnd > AccessBeg.

// A pointer-width scalar table can accidentally look like an address array:
// a dense indexed load supplies data-access points, while regularly spaced
// bit patterns happen to land at misaligned data addresses.  That combination
// is not pointer evidence by itself.  The load is an object-level witness:
// inferred data limits may prevent preferred_data_access from propagating to
// every scalar cell in a real table.
.decl pointer_width_dense_access(
          AccessBase:address,Pt_size:unsigned,LoadEA:address)

pointer_width_dense_access(AccessBase,Pt_size,LoadEA):-
    arch.pointer_size(Pt_size),
    data_access_pattern_candidate_refined(
        AccessBase,Pt_size,Mult,LoadEA),
    Mult = as(Pt_size,number),
    dap_max_mult(AccessBase,Pt_size,Mult),
    arch.load(LoadEA,_,_,_,_,_,_,_).

// Some architectures represent paired loads as multiple arch.load facts at
// one instruction address, while DAP currently retains only that instruction
// address and not its operand index.  Such an access remains valid negative
// evidence, but cannot safely be coupled to one loaded register for recovery.
.decl ambiguous_pointer_width_dense_load(
          AccessBase:address,Pt_size:unsigned,LoadEA:address)

ambiguous_pointer_width_dense_load(AccessBase,Pt_size,LoadEA):-
    pointer_width_dense_access(AccessBase,Pt_size,LoadEA),
    arch.load(LoadEA,_,_,DstReg1,_,_,_,_),
    arch.load(LoadEA,_,_,DstReg2,_,_,_,_),
    DstReg1 != DstReg2.

.decl pointer_width_dense_load(
          AccessBase:address,Pt_size:unsigned,
          LoadEA:address,DstReg:register)

pointer_width_dense_load(AccessBase,Pt_size,LoadEA,DstReg):-
    pointer_width_dense_access(AccessBase,Pt_size,LoadEA),
    arch.load(LoadEA,_,_,DstReg,_,_,_,_),
    !ambiguous_pointer_width_dense_load(
        AccessBase,Pt_size,LoadEA).

.decl source_object_with_pointer_width_dense_load(
          SrcBeg:address,SrcSize:unsigned,Pt_size:unsigned)

source_object_with_pointer_width_dense_load(SrcBeg,SrcSize,Pt_size):-
    defined_symbol(SrcBeg,SrcSize,"OBJECT",_,_,_,_,_,_),
    SrcSize > 0,
    pointer_width_dense_access(AccessBase,Pt_size,_),
    AccessBase >= SrcBeg,
    AccessBase+Pt_size <= SrcBeg+SrcSize.

// Select the smallest original OBJECT containing the candidate.  This keeps
// a dense load in one nested subobject from classifying an unrelated sibling
// merely because both share a broader enclosing symbol.
.decl source_object_containing_candidate(
          EA:address,Pt_size:unsigned,
          SrcBeg:address,SrcSize:unsigned)

source_object_containing_candidate(EA,Pt_size,SrcBeg,SrcSize):-
    data_object_candidate(EA,Pt_size,"symbol"),
    defined_symbol(SrcBeg,SrcSize,"OBJECT",_,_,_,_,_,_),
    SrcSize > 0,
    EA >= SrcBeg,
    EA+Pt_size <= SrcBeg+SrcSize.

.decl more_specific_source_object_containing_candidate(
          EA:address,Pt_size:unsigned,
          SrcBeg:address,SrcSize:unsigned)

more_specific_source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize):-
    source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize),
    source_object_containing_candidate(
        EA,Pt_size,_,MoreSpecificSize),
    MoreSpecificSize < SrcSize.

.decl innermost_source_object_containing_candidate(
          EA:address,Pt_size:unsigned,
          SrcBeg:address,SrcSize:unsigned)

innermost_source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize):-
    source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize),
    !more_specific_source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize).

// Arrays of records can interleave several pointer fields and contain null
// entries. The nearest-address heuristic cannot see a column through a
// different pointer column. Infer a column only from three non-null entries
// in the first three records of one sized OBJECT. Its stride must divide the
// object size; subsequent entries must be pointers into the same data segment
// or null. A scalar word, section change or original source boundary stops
// propagation. This is source-layout evidence, not a new arch.load/value fact.
.decl object_data_pointer_field(EA:address,SrcBeg:address,SrcSize:unsigned,
                                Range:address,DestBeg:address,DestEnd:address)

object_data_pointer_field(EA,SrcBeg,SrcSize,Range,DestBeg,DestEnd):-
    arch.pointer_size(PtSize),
    innermost_source_object_containing_candidate(EA,PtSize,SrcBeg,SrcSize),
    initialized_data_segment(SegmentBeg,SegmentEnd),
    SegmentBeg <= SrcBeg,
    SrcBeg+SrcSize > SrcBeg,
    SrcBeg+SrcSize <= SegmentEnd,
    EA % PtSize = 0,
    SrcBeg % PtSize = 0,
    SrcSize % PtSize = 0,
    address_in_data_refined(EA,Dest),
    data_segment(DestBeg,DestEnd),
    DestBeg <= Dest, Dest < DestEnd,
    // Unanchored interior targets must have pointer alignment. Packed
    // scalar tables frequently contain misaligned address-shaped values;
    // repeated fields alone are not evidence for those byte destinations.
    // Symbols and independently inferred string starts are stronger anchors.
    (
        Dest % PtSize = 0
        ;
        defined_symbol(Dest,_,_,_,_,_,_,_,_)
        ;
        string_candidate_refined(Dest,_,_)
    ),
    pointer_candidate_source_range(EA,Range).

.decl nullable_pointer_column_seed(EA:address,Stride:unsigned,
                                  SrcBeg:address,SrcSize:unsigned,
                                  Range:address,DestBeg:address,DestEnd:address)

// Enumerate divisors of an OBJECT's size, not pairs of pointer candidates.
// Dense tables can have many fields; a quadratic candidate join is avoidable.
.decl nullable_pointer_record_stride(SrcSize:unsigned,Stride:unsigned)

nullable_pointer_record_stride(SrcSize,Stride):-
    arch.pointer_size(PtSize),
    object_data_pointer_field(_,_,SrcSize,_,_,_),
    Stride = range(2*PtSize,SrcSize/3+1,PtSize),
    SrcSize % Stride = 0.

nullable_pointer_column_seed(EA,Stride,SrcBeg,SrcSize,Range,DestBeg,DestEnd):-
    arch.pointer_size(PtSize),
    object_data_pointer_field(EA,SrcBeg,SrcSize,Range,DestBeg,DestEnd),
    nullable_pointer_record_stride(SrcSize,Stride),
    EA-SrcBeg < Stride,
    EA+2*Stride+PtSize <= SrcBeg+SrcSize,
    object_data_pointer_field(EA+Stride,SrcBeg,SrcSize,Range,DestBeg,DestEnd),
    object_data_pointer_field(EA+2*Stride,SrcBeg,SrcSize,Range,DestBeg,DestEnd).

.decl nullable_pointer_column(EA:address,Stride:unsigned,
                             SrcBeg:address,SrcSize:unsigned,
                             Range:address,DestBeg:address,DestEnd:address)

nullable_pointer_column(EA,Stride,SrcBeg,SrcSize,Range,DestBeg,DestEnd):-
    nullable_pointer_column_seed(EA,Stride,SrcBeg,SrcSize,Range,DestBeg,DestEnd).

nullable_pointer_column(Next,Stride,SrcBeg,SrcSize,Range,DestBeg,DestEnd):-
    arch.pointer_size(PtSize),
    nullable_pointer_column(EA,Stride,SrcBeg,SrcSize,Range,DestBeg,DestEnd),
    Next = EA+Stride,
    Next > EA,
    Next+PtSize <= SrcBeg+SrcSize,
    (
        object_data_pointer_field(Next,SrcBeg,SrcSize,Range,DestBeg,DestEnd)
        ;
        data_uword(Next,PtSize,0)
    ).

.decl nullable_pointer_column_member(EA:address,PtSize:unsigned)

nullable_pointer_column_member(EA,PtSize):-
    arch.pointer_size(PtSize),
    nullable_pointer_column(EA,_,SrcBeg,SrcSize,Range,DestBeg,DestEnd),
    object_data_pointer_field(EA,SrcBeg,SrcSize,Range,DestBeg,DestEnd).

// A complete, aligned OBJECT made solely of data pointers and zero words is
// another common nullable-pointer layout. Require at least three independent
// anchors (exact target symbols or string starts), not merely three arbitrary
// address-shaped integers. Every word must pass the layout check, and original
// nested symbols/OBJECT ends prohibit borrowing evidence across subobjects.
.decl anchored_pointer_object_slot(EA:address,SrcBeg:address,SrcSize:unsigned)

anchored_pointer_object_slot(EA,SrcBeg,SrcSize):-
    object_data_pointer_field(EA,SrcBeg,SrcSize,_,_,_),
    address_in_data_refined(EA,Dest),
    (
        defined_symbol(Dest,_,_,_,_,_,_,_,_)
        ;
        string_candidate_refined(Dest,_,_)
    ).

.decl anchored_pointer_object(SrcBeg:address,SrcSize:unsigned)

anchored_pointer_object(SrcBeg,SrcSize):-
    anchored_pointer_object_slot(_,SrcBeg,SrcSize),
    N = count : { anchored_pointer_object_slot(_,SrcBeg,SrcSize) },
    N >= 3.

.decl nonpointer_word_in_anchored_object(SrcBeg:address,SrcSize:unsigned)

nonpointer_word_in_anchored_object(SrcBeg,SrcSize):-
    anchored_pointer_object(SrcBeg,SrcSize),
    arch.pointer_size(PtSize),
    EA = range(SrcBeg,SrcBeg+SrcSize,PtSize),
    data_uword(EA,PtSize,Value),
    Value != 0,
    !object_data_pointer_field(EA,SrcBeg,SrcSize,_,_,_).

.decl original_boundary_inside_object(SrcBeg:address,SrcSize:unsigned)

original_boundary_inside_object(SrcBeg,SrcSize):-
    anchored_pointer_object(SrcBeg,SrcSize),
    pointer_source_boundary(Boundary),
    SrcBeg < Boundary, Boundary < SrcBeg+SrcSize.

.decl complete_nullable_pointer_object_member(EA:address,PtSize:unsigned)

complete_nullable_pointer_object_member(EA,PtSize):-
    arch.pointer_size(PtSize),
    object_data_pointer_field(EA,SrcBeg,SrcSize,_,_,_),
    anchored_pointer_object(SrcBeg,SrcSize),
    initialized_data_segment(Beg,End),
    Beg <= SrcBeg, SrcBeg+SrcSize <= End,
    !nonpointer_word_in_anchored_object(SrcBeg,SrcSize),
    !original_boundary_inside_object(SrcBeg,SrcSize).

data_object_point(EA,PtSize,"symbol",3,"bounded nullable pointer layout"):-
    (
        nullable_pointer_column_member(EA,PtSize)
        ;
        complete_nullable_pointer_object_member(EA,PtSize)
    ),
    // Repetition alone must not override evidence that the source bytes are
    // used as text. The stronger existing string-pointer rules decide those
    // collisions independently (and deliberately require more records).
    !referenced_short_string_pointer_collision(EA,PtSize),
    !unanchored_pointer_inside_referenced_string(EA,PtSize),
    !unanchored_pointer_with_referenced_string_suffix(EA,PtSize).

// Parser and callback tables commonly alternate a pointer to an anonymous
// string with a pointer to the function that handles that name.  The ordinary
// address-array heuristic cannot see the string field at a 2*pointer stride,
// because the intervening code pointer becomes the next address candidate.
// This matters when the low bytes of a string address are themselves printable:
// the source field then also looks like a short string and can lose the normal
// symbol/string score comparison.
//
// Treat three consecutive {string, code} records inside the same innermost
// nonzero OBJECT as independent source-layout evidence.  Sliding three-record
// seeds cover every member of a longer run while keeping isolated pairs and
// runs split by nested OBJECT boundaries unchanged.
.decl string_code_descriptor_record(
          EA:address,SrcBeg:address,SrcSize:unsigned)

string_code_descriptor_record(EA,SrcBeg,SrcSize):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,StringEA),
    string_candidate_refined(StringEA,_,_),
    data_object_candidate(EA+Pt_size,Pt_size,"symbol"),
    address_in_data_refined(EA+Pt_size,CodeEA),
    code(CodeEA),
    innermost_source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize),
    EA+2*Pt_size <= SrcBeg+SrcSize.

.decl string_code_descriptor_seed(EA:address)

string_code_descriptor_seed(EA):-
    arch.pointer_size(Pt_size),
    string_code_descriptor_record(EA,SrcBeg,SrcSize),
    string_code_descriptor_record(EA+2*Pt_size,SrcBeg,SrcSize),
    string_code_descriptor_record(EA+4*Pt_size,SrcBeg,SrcSize).

.decl string_code_descriptor_member(EA:address)

string_code_descriptor_member(EA):-
    string_code_descriptor_seed(EA).

string_code_descriptor_member(EA+2*Pt_size):-
    arch.pointer_size(Pt_size),
    string_code_descriptor_seed(EA).

string_code_descriptor_member(EA+4*Pt_size):-
    arch.pointer_size(Pt_size),
    string_code_descriptor_seed(EA).

data_object_point(EA,Pt_size,"symbol",2,
                  "string/code descriptor record"):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    string_code_descriptor_member(EA).

// Data-access propagation intentionally stops at inferred limits such as long
// zero runs.  The compiler's nonzero OBJECT extent still provides a safe
// boundary for carrying a dense narrow-element layout to a later candidate.
// Requiring the same innermost object avoids leaking evidence into a sibling
// nested object, the scalar-stride/extent checks require an array-shaped
// source, and an exact destination symbol remains independent pointer evidence.
unanchored_pointer_window_with_narrow_access(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    innermost_source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize),
    SrcSize >= 4*Pt_size,
    subpointer_width_dense_access(
        AccessBase,AccessSize,Pt_size,_),
    SrcSize % AccessSize = 0,
    AccessBase >= SrcBeg,
    AccessBase+AccessSize <= SrcBeg+SrcSize,
    EA >= AccessBase,
    (EA-AccessBase) % AccessSize = 0,
    address_in_data_refined(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    !defined_symbol(EA,_,_,_,_,_,_,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

// Apply bounded narrow-access evidence only to the proven source range.  This
// is intentionally more local than the object-wide DAP rule above: an OBJECT
// may contain pointer fields outside the masked scalar subarray.
unanchored_pointer_window_with_narrow_access(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    innermost_source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize),
    SrcSize >= 4*Pt_size,
    bounded_subpointer_width_access(
        AccessBeg,AccessEnd,AccessSize,Pt_size,_),
    SrcSize % AccessSize = 0,
    AccessBeg >= SrcBeg,
    AccessEnd <= SrcBeg+SrcSize,
    EA >= AccessBeg,
    EA+Pt_size <= AccessEnd,
    (EA-AccessBeg) % AccessSize = 0,
    address_in_data_refined(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    !defined_symbol(EA,_,_,_,_,_,_,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

.decl dense_misaligned_candidate_in_object(
          EA:address,Pt_size:unsigned,
          SrcBeg:address,SrcSize:unsigned)

dense_misaligned_candidate_in_object(EA,Pt_size,SrcBeg,SrcSize):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    Dest % Pt_size != 0,
    address_array_aux(EA,_,"data",_),
    innermost_source_object_containing_candidate(
        EA,Pt_size,SrcBeg,SrcSize),
    source_object_with_pointer_width_dense_load(
        SrcBeg,SrcSize,Pt_size),
    EA >= SrcBeg.

// Project away source-object and load witnesses before assigning a score.
// Souffle relations already have set semantics, but this explicitly makes
// the one-penalty-per-candidate invariant independent of witness count.
.decl densely_indexed_interior_data_load(
          EA:address,Pt_size:unsigned)

densely_indexed_interior_data_load(EA,Pt_size):-
    dense_misaligned_candidate_in_object(EA,Pt_size,_,_).

data_object_point(EA,Pt_size,"symbol",-10,
                  "dense indexed scalar array resembles data pointers"):-
    densely_indexed_interior_data_load(EA,Pt_size).

// String tables are a genuine instance of the same dense indexed-load shape:
// the array holds pointers to adjacent, unlabeled string literals and the
// loaded pointer may be returned or passed to another function rather than
// dereferenced locally.  Exact starts of independently inferred strings are
// strong target evidence.  Require three such members in the same
// pointer-width data array before cancelling the dense-scalar penalty, so an
// isolated integer that happens to equal a string address is not recovered.
.decl dense_string_pointer_array_member(EA:address,Pt_size:unsigned)

dense_string_pointer_array_member(EA,Pt_size):-
    densely_indexed_interior_data_load(EA,Pt_size),
    address_array_aux(EA,Pt_size,"data",InitialEA),
    address_in_data_refined(EA,Dest),
    string_candidate_refined(Dest,_,_),
    address_array_aux(WitnessEA1,Pt_size,"data",InitialEA),
    address_in_data_refined(WitnessEA1,WitnessDest1),
    string_candidate_refined(WitnessDest1,_,_),
    WitnessEA1 != EA,
    address_array_aux(WitnessEA2,Pt_size,"data",InitialEA),
    address_in_data_refined(WitnessEA2,WitnessDest2),
    string_candidate_refined(WitnessDest2,_,_),
    WitnessEA2 != EA,
    WitnessEA2 != WitnessEA1.

data_object_point(EA,Pt_size,"symbol",10,
                  "member of dense pointer array to string starts"):-
    dense_string_pointer_array_member(EA,Pt_size).

// Object-wide evidence must not drive recovery: a mixed object may contain an
// unrelated genuine pointer subarray.  Re-establish candidate-to-load
// provenance through preferred_data_access before inspecting uses of the
// exact value produced by that load.
.decl dense_misaligned_candidate_load(
          EA:address,Pt_size:unsigned,
          AccessBase:address,LoadEA:address,DstReg:register)

dense_misaligned_candidate_load(
        EA,Pt_size,AccessBase,LoadEA,DstReg):-
    dense_misaligned_candidate_in_object(
        EA,Pt_size,SrcBeg,SrcSize),
    preferred_data_access(EA,Pt_size,AccessBase),
    AccessBase >= SrcBeg,
    AccessBase+Pt_size <= SrcBeg+SrcSize,
    pointer_width_dense_load(
        AccessBase,Pt_size,LoadEA,DstReg).

// Restore a candidate only when the exact loaded value is directly used as a
// memory base.  Base-register matching deliberately excludes numeric values
// used merely as scaled indices.  Projecting to (EA,Pt_size) guarantees a
// single recovery score even when several equivalent uses or load witnesses
// exist.
.decl densely_indexed_interior_data_load_recovered(
          EA:address,Pt_size:unsigned)

densely_indexed_interior_data_load_recovered(EA,Pt_size):-
    dense_misaligned_candidate_load(
        EA,Pt_size,_,LoadEA,DstReg),
    reg_def_use.def_used(LoadEA,DstReg,UseEA,_),
    arch.memory_access(
        _,UseEA,_,_,_,as(DstReg,reg_nullable),_,_,_).

data_object_point(EA,Pt_size,"symbol",10,
                  "dense indexed value directly used as address"):-
    densely_indexed_interior_data_load_recovered(EA,Pt_size).

// Targets stored in constructor/destructor and similar function-pointer
// sections are independent function-entry evidence.  Derive this directly
// from the raw data value rather than final function inference, which itself
// depends on symbolic_data and would introduce a negative dependency cycle.
.decl function_pointer_section_reference(Src:address,Dest:address)

function_pointer_section_reference(Src,Dest):-
    address_in_data_refined(Src,Dest),
    function_pointer_section(Name),
    loaded_section(Beg,End,Name),
    Src >= Beg,
    Src < End,
    code(Dest).

// An integer stored in data can accidentally equal the address of an
// instruction in the middle of a function.  A pointer-sized load and source
// alignment do not distinguish that collision from a pointer.  Apply a strong
// penalty when the target has neither function-entry provenance nor an
// original symbol.  A relocation or demonstrated downstream address use can
// still retain a genuine stripped interior pointer; adjacency alone cannot.
data_object_point(EA,Pt_size,"symbol",-10,"points at unlabeled interior code"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    code(Dest),
    !function_inference.function_entry_initial(Dest),
    !function_pointer_section_reference(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_).

// Recover an unlabeled interior pointer when a pointer-sized load is proven to
// feed an indirect branch or call.  Limiting this to control-flow use avoids
// treating ordinary integer indices or lengths as pointers merely because
// they participate in a memory-address computation.
.decl interior_code_pointer_used_for_control_flow(
          EA:address,Pt_size:unsigned)

interior_code_pointer_used_for_control_flow(EA,Pt_size):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    code(Dest),
    !function_inference.function_entry_initial(Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    preferred_data_access(EA,Pt_size,AccessBase),
    data_access_pattern(AccessBase,Pt_size,_,LoadEA),
    arch.load(LoadEA,_,_,DstReg,_,_,_,_),
    reg_def_use.def_used(LoadEA,DstReg,TransferEA,_),
    (
        reg_call(TransferEA,DstReg)
        ;
        reg_jump(TransferEA,DstReg)
    ).

// A direct memory-indirect transfer consumes the pointer from its slot without
// first defining a general-purpose register, so it has no arch.load relation.
// Preserve that equally strong address-use evidence separately.
interior_code_pointer_used_for_control_flow(EA,Pt_size):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    code(Dest),
    !function_inference.function_entry_initial(Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    preferred_data_access(EA,Pt_size,AccessBase),
    data_access_pattern(AccessBase,Pt_size,_,TransferEA),
    (
        indirect_call(TransferEA)
        ;
        indirect_jump(TransferEA)
    ).

data_object_point(EA,Pt_size,"symbol",10,
                  "interior code pointer used for control flow"):-
    interior_code_pointer_used_for_control_flow(EA,Pt_size).

// jump_table_element_access identifies the table base for an indexed load,
// but preferred_data_access may not propagate that evidence to any individual
// cell when the loaded value is transferred directly to a register jump.  In
// that case, use the independently inferred index bound to retain exactly the
// addressed subarray.  Do not couple multi-result loads to one destination
// register: DAP currently records the instruction address, not its operand.
.decl ambiguous_jump_table_load(LoadEA:address)

ambiguous_jump_table_load(LoadEA):-
    arch.load(LoadEA,_,_,DstReg1,_,_,_,_),
    arch.load(LoadEA,_,_,DstReg2,_,_,_,_),
    DstReg1 != DstReg2.

// Bounds/value propagation can enumerate only a subset of the cells consumed
// by an indexed indirect branch.  Once one cell in a contiguous code-pointer
// array is proven to feed control flow, the other members are equally strong
// pointer evidence.  Restricting this to a pointer-width stride and an already
// established all-code address_array keeps the recovery local to the exact
// array; unrelated or interleaved address-shaped integers remain penalized.
.decl control_flow_code_pointer_array_member(
          EA:address,Pt_size:unsigned)

control_flow_code_pointer_array_member(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    address_array_aux(EA,Pt_size,"code",InitialEA),
    address_array_aux(WitnessEA,Pt_size,"code",InitialEA),
    interior_code_pointer_used_for_control_flow(WitnessEA,Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    code(Dest),
    !function_inference.function_entry_initial(Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    !interior_code_pointer_used_for_control_flow(EA,Pt_size).

// A separate indexed load followed immediately by a register jump/call is the
// register form of the memory-indirect transfer above.  Requiring a proven
// jump-table maximum avoids extending the evidence into adjacent code-looking
// constants even when they form one larger address array.
control_flow_code_pointer_array_member(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    address_array_aux(EA,Pt_size,"code",TableStart),
    jump_table_element_access(LoadEA,Pt_size,TableStart,_),
    jump_table_max(TableStart,TableEnd),
    EA <= TableEnd,
    arch.load(LoadEA,_,_,DstReg,_,_,_,_),
    !ambiguous_jump_table_load(LoadEA),
    reg_def_use.def_used(LoadEA,DstReg,TransferEA,_),
    (
        reg_call(TransferEA,DstReg)
        ;
        reg_jump(TransferEA,DstReg)
    ),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    code(Dest),
    !function_inference.function_entry_initial(Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    !interior_code_pointer_used_for_control_flow(EA,Pt_size).

// A memory-indirect jump or call consumes its table entry without first
// loading it into a general-purpose register.  In particular, an x86 switch
// may use `jmp *table(,index,ptrsize)`: jump-table analysis identifies the
// table base and access width, but preferred_data_access is intentionally not
// populated for the transfer instruction.  Preserve every member of the
// exact contiguous all-code array addressed by that transfer.
control_flow_code_pointer_array_member(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    address_array_aux(EA,Pt_size,"code",InitialEA),
    jump_table_element_access(TransferEA,Pt_size,InitialEA,_),
    (
        indirect_call(TransferEA)
        ;
        indirect_jump(TransferEA)
    ),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    code(Dest),
    !function_inference.function_entry_initial(Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    !interior_code_pointer_used_for_control_flow(EA,Pt_size).

data_object_point(EA,Pt_size,"symbol",10,
                  "member of code-pointer array used for control flow"):-
    control_flow_code_pointer_array_member(EA,Pt_size).

data_object_point(EA,Pt_size,"symbol",-2,"potentially bitmask"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    EA % Pt_size = 0,
    address_in_data_refined(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    0 = (Dest band 0xFFFFF).

data_object_point(EA,Pt_size,"symbol",-2,"printerable address: likely spurious"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    EA % Pt_size = 0,
    address_in_data_is_printable(EA),
    address_in_data_refined(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_).

data_object_point(EA,Pt_size,"symbol",-1,"overlaps string: likely spurious"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    EA % Pt_size = 0,
    address_in_data_overlaps_string(EA,EAString),
    ascii_string(EAString,End),
    End - EAString > 4,
    address_in_data_refined(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_).

// A short NUL-terminated text field followed by padding can occupy exactly one
// pointer-sized slot.  Its little-endian bytes may accidentally equal a mapped
// address even though the text is not a pointer (short format and algorithm
// names are common examples).  An independent code or aligned data reference
// to the start of the field establishes that the bytes are used as a string;
// unlike fixed-width name pools, an isolated compiler literal need not have an
// adjacent string.  Pointer fields can have the same printable low bytes and
// can also be reached from code, so preserve candidates with a relocation,
// pointer-width source access, or pointer-array structure.  Source alignment
// and the absence of label conflicts give the remaining candidate a weak
// positive score, so add enough negative evidence to keep it literal.  Exact
// target symbols remain authoritative.  The raw data reference form is
// intentionally source-side evidence only: option and name tables commonly
// point at these strings even when no instruction materializes the string
// address directly.
.decl short_string_source_reference(EA:address)

short_string_source_reference(EA):-
    symbolic_operand(_,_,EA,"data").

short_string_source_reference(EA):-
    arch.pointer_size(Pt_size),
    address_in_data_refined(RefEA,EA),
    RefEA % Pt_size = 0,
    RefEA != EA.

// A descriptor table can begin with an anonymous-string pointer whose low
// little-endian bytes themselves form a short NUL-terminated string.  A code
// reference to the table base then supplies exactly the source-side evidence
// used by the short-string collision guard below, so the leading pointer can
// lose even though the same field is correctly retained in every later
// record.  Recover only the leading field of a nonzero OBJECT when five
// records repeat the same exact inferred-string target at one pointer-aligned
// stride.  Four records are deliberately insufficient, and original symbol
// or nested-OBJECT boundaries split the pattern.
.decl leading_repeated_string_pointer_record(EA:address)

leading_repeated_string_pointer_record(EA):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    string_candidate_refined(Dest,_,_),
    innermost_source_object_containing_candidate(
        EA,Pt_size,EA,SrcSize),
    ascii_string(EA,StringEnd),
    StringEnd >= EA+3,
    StringEnd < EA+Pt_size,
    short_string_source_reference(EA),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_),
    data_object_candidate(EA1,Pt_size,"symbol"),
    address_in_data_refined(EA1,Dest),
    EA1 > EA,
    Stride = EA1-EA,
    Stride >= 4*Pt_size,
    Stride % Pt_size = 0,
    data_object_candidate(EA1+Stride,Pt_size,"symbol"),
    address_in_data_refined(EA1+Stride,Dest),
    data_object_candidate(EA1+2*Stride,Pt_size,"symbol"),
    address_in_data_refined(EA1+2*Stride,Dest),
    data_object_candidate(EA1+3*Stride,Pt_size,"symbol"),
    address_in_data_refined(EA1+3*Stride,Dest),
    EA+4*Stride+Pt_size <= EA+SrcSize,
    pointer_candidate_source_range(EA,Range),
    pointer_candidate_source_range(EA+4*Stride,Range).

data_object_point(EA,Pt_size,"symbol",2,
                  "leading field in repeated string-pointer records"):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    leading_repeated_string_pointer_record(EA).

// A pointer-width window can begin strictly inside a longer referenced string.
// On little-endian executables, a printable suffix followed by the string
// terminator and padding can accidentally equal the exact address of a real
// symbol.  Destination identity still does not establish a source-field
// boundary, even when the suffix happens to begin at a naturally aligned
// address.  Require a substantial printable prefix and an independent
// reference to the actual string start, then reject only source windows with
// no relocation, pointer-width access, or pointer-array evidence.  A genuine
// packed pointer remains recoverable through any of those anchors.
.decl unanchored_pointer_inside_referenced_string(
          EA:address,Pt_size:unsigned)

unanchored_pointer_inside_referenced_string(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    ascii_string(StringEA,End),
    EA >= StringEA+3,
    EA < End,
    short_string_source_reference(StringEA),
    !defined_symbol(EA,_,_,_,_,_,_,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

data_object_point(EA,Pt_size,"symbol",-5,
                  "source begins inside referenced string"):-
    unanchored_pointer_inside_referenced_string(EA,Pt_size).

// The converse overlap occurs when one or more zero padding bytes immediately
// precede a referenced short string.  On little-endian executables the whole
// pointer-width window can then equal an exact low code address: for example,
// 00 44 48 00... is both 0x484400 and the padding-plus-"DH" bytes used by an
// OpenSSL name table.  Relayout would otherwise change the string when the
// unrelated code symbol moves.  Recover only a bounded all-zero prefix and an
// independently referenced string suffix, and preserve candidates that have
// their own source symbol, relocation, pointer-width access, or array shape.
.decl candidate_zero_prefix(
          Beg:address,End:address,Count:unsigned,Pt_size:unsigned)

candidate_zero_prefix(Beg,Beg+1,1,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(Beg,Pt_size,"symbol"),
    data_byte(Beg,0).

candidate_zero_prefix(Beg,End+1,Count+1,Pt_size):-
    candidate_zero_prefix(Beg,End,Count,Pt_size),
    Count < Pt_size-1,
    data_byte(End,0).

.decl unanchored_pointer_with_referenced_string_suffix(
          EA:address,Pt_size:unsigned)

unanchored_pointer_with_referenced_string_suffix(EA,Pt_size):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    candidate_zero_prefix(EA,StringEA,PrefixSize,Pt_size),
    PrefixSize < Pt_size,
    ascii_string(StringEA,End),
    End >= StringEA+2,
    StringEA < EA+Pt_size,
    short_string_source_reference(StringEA),
    !defined_symbol(EA,_,_,_,_,_,_,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

// Selection accepts a total score of zero.  Use -6 so the strongest otherwise
// unanchored aligned case (bias -2, alignment +2, exact target +5) remains
// below that threshold; the referenced suffix itself creates a label conflict
// and therefore prevents the ordinary no-conflict point.
data_object_point(EA,Pt_size,"symbol",-6,
                  "zero prefix overlaps referenced string"):-
    unanchored_pointer_with_referenced_string_suffix(EA,Pt_size).

.decl referenced_short_string_pointer_collision(EA:address,Pt_size:unsigned)

referenced_short_string_pointer_collision(EA,Pt_size):-
    data_object_candidate(EA,Pt_size,"symbol"),
    EA % Pt_size = 0,
    ascii_string(EA,End),
    End >= EA+3,
    End < EA+Pt_size,
    short_string_source_reference(EA),
    address_in_data_refined(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

data_object_point(EA,Pt_size,"symbol",-2,
                  "short string prefix resembles address"):-
    referenced_short_string_pointer_collision(EA,Pt_size).

// A named multiword object can begin with a pointer to an anonymous string.
// When the target address has three printable low bytes, the stored pointer
// is also a plausible short string at the source and the guard above makes the
// source string win.  An exact OBJECT start establishes the field boundary,
// while the independently inferred string establishes the destination type.
// Recover only this direct conflict: the source must itself be the referenced
// short-string candidate, the target must have no original symbol, and the
// object must not repeat the same value in later slots.  The latter keeps a
// short run of address-shaped scalar records literal; the stronger existing
// repeated-record rule independently handles a five-record pointer pattern.
// Scalar or pointer access evidence, relocations, and pointer arrays remain
// governed by their existing rules.  Three points are needed because the
// symbol starts at -1 and the conflicting source string scores +1.
.decl named_object_has_later_same_pointer(
          EA:address,Pt_size:unsigned,Dest:address)

named_object_has_later_same_pointer(EA,Pt_size,Dest):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    defined_symbol(EA,SrcSize,"OBJECT",_,_,_,_,_,_),
    SrcSize > 0,
    data_object_candidate(Later,Pt_size,"symbol"),
    address_in_data_refined(Later,Dest),
    Later > EA,
    Later+Pt_size <= EA+SrcSize.

data_object_point(EA,Pt_size,"symbol",3,
                  "named object begins with anonymous string pointer"):-
    arch.pointer_size(Pt_size),
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    string_candidate_refined(Dest,_,_),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    defined_symbol(EA,SrcSize,"OBJECT",_,_,_,_,_,_),
    SrcSize >= 2*Pt_size,
    SrcSize % Pt_size = 0,
    ascii_string(EA,End),
    End >= EA+3,
    End < EA+Pt_size,
    short_string_source_reference(EA),
    !named_object_has_later_same_pointer(EA,Pt_size,Dest),
    !relocation(EA,_,_,_,_,_,_),
    !preferred_data_access(EA,Pt_size,_),
    !preferred_data_access(EA,0,_),
    !address_array(EA,_,_).

// Fixed-width name tables commonly store a short NUL-terminated string in
// each pointer-sized slot and zero-fill the remainder.  On little-endian
// binaries, three printable bytes plus the terminator can also be a plausible
// low address (for example, "MD5\0" is 0x35444d).  Treat the middle member of
// a three-slot run as text even when it has no direct code reference.  Requiring
// printable strings at the exact neighboring slot starts distinguishes this
// layout from an isolated address candidate; genuine address arrays retain
// their independent array points, and relocations or exact target symbols
// remain authoritative.
data_object_point(EA,Pt_size,"symbol",-2,
                  "short string in fixed-width string pool"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    EA >= Pt_size,
    EA % Pt_size = 0,
    ascii_string(EA-Pt_size,PrevEnd),
    PrevEnd >= EA-Pt_size+3,
    PrevEnd < EA,
    ascii_string(EA,End),
    End >= EA+3,
    End < EA+Pt_size,
    ascii_string(EA+Pt_size,NextEnd),
    NextEnd >= EA+Pt_size+3,
    NextEnd < EA+2*Pt_size,
    address_in_data_refined(EA,Dest),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_).

data_object_point(EA,Pt_size,"symbol",4,"point-to-boundary-sym"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    boundary_sym_expr(EA,Dest,_).

data_object_point(EA,Pt_size,"symbol",-2,"point-to-exception-section"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    exception_section(Name),
    loaded_section(Base,End,Name),
    Dest >= Base, Dest < End.

data_object_point(EA,Pt_size,"symbol",-1,"point-to-special-section"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    address_in_data_refined(EA,Dest),
    special_data_section(Name),
    loaded_section(Base,End,Name),
    Dest >= Base, Dest < End.

data_object_point(EA,Pt_size,"symbol",10,"has relocation"):-
    data_object_candidate(EA,Pt_size,"symbol"),
    relocation(EA,Type,_,_,_,_,_),
    Type != "ABSOLUTE".

data_object_point(EA,Pt_size,"symbol",-10,"has no relocation"):-
    !binary_type("EXEC"),
    // On MIPS, not every GOT entry is associated with a relocation.
    // All dynamic function calls are performed through the GOT.
    // For symbols defined within the same DSO, the GOT entries are
    // resolved at link time.
    !binary_isa("MIPS"),
    data_object_candidate(EA,Pt_size,"symbol"),
    !relocation(EA,_,_,_,_,_,_).

// Points for well-defined strings:
data_object_point(EA,Size,"string",2,"string basic point"):-
    data_object_candidate(EA,Size,"string").

data_object_point(EA,Size,"string",3,"long string"):-
    data_object_candidate(EA,Size,"string"),
    string_candidate(EA,End,_),
    string_candidate(Beg,End,_), End-Beg > 5.

data_object_point(EA,Size,"string",-2,"string in jump table"):-
    data_object_candidate(EA,Size,"string"),
    preferred_data_access(EA,_,EA_ref),
    jump_table_start(_,_,EA_ref,_,_).

data_object_point(EA,Size,"string",1,"string that has reference"):-
    data_object_candidate(EA,Size,"string"),
    may_have_symbolic_immediate(Code,EA),
    code(Code),
    data_limit(EA).

data_object_point(EA,Size,"string",1,"string has string neighbors"):-
    data_object_candidate(EA,Size,"string"),
    subsequent_string_candidate(EA,_),
    subsequent_string_candidate(_,EA).

// data access negative heuristic
data_object_point(EA,Size,"other",4,"data access"):-
    data_object_candidate(EA,Size,"other"),
    Size < 16.

//sometimes we load pointers into xmm
data_object_point(EA,Size,"other",1,"data access xmm"):-
    data_object_candidate(EA,Size,"other"),
    Size >= 16.

//range mismatch
data_object_conflict(EA,Size,Type,EA2,Size2,Type2):-
    data_object_candidate(EA,Size,Type),
    data_object_candidate(EA2,Size2,Type2),
    EA2 > EA,
    EA2 < EA+Size.

//size mismatch
data_object_conflict(EA,Size,Type,EA,Size2,Type2):-
    data_object_candidate(EA,Size,Type),
    data_object_candidate(EA,Size2,Type2),
    Size2 > Size.

//type mismatch
data_object_conflict(EA,Size,Type,EA,Size,Type2):-
    data_object_candidate(EA,Size,Type),
    data_object_candidate(EA,Size,Type2),
    Type != Type2.

// Destination collides with another candidate.
data_object_conflict(EA,Size,Type,EA2,Size2,Type2):-
    binary_format("PE"), binary_isa("X86"),
    // Candidate references another data location,
    data_object_candidate(EA,Size,Type),
    address_in_data_refined(EA,Val),
    // but would collide with another candidate symbol at that location.
    data_object_candidate(EA2,Size2,Type2),
    Val > EA2,
    Val < EA2+Size2.

.decl data_object_total_points(EA:address,Size:unsigned,Type:symbol,Points:number)

data_object_total_points(EA,Size,Type,Points):-
    data_object_candidate(EA,Size,Type),
    Points = sum X:{data_object_point(EA,Size,Type,X,_)}.

data_object(EA,Size,Type):-
    data_object_total_points(EA,Size,Type,Points),
    !discarded_data_object(EA,Size,Type),
    Points >= 0.

discarded_data_object(EA_f,Size_f,Type_f):-
    data_object_conflict(EA,Size,Type,EA2,Size2,Type2),
    data_object_total_points(EA,Size,Type,Points1),
    data_object_total_points(EA2,Size2,Type2,Points2),
    (
        Points1 < Points2,
        EA_f = EA,
        Size_f = Size,
        Type_f = Type
        ;
        Points1 > Points2,
        EA_f = EA2,
        Size_f = Size2,
        Type_f = Type2
    ).

// predicates to export

symbolic_data(EA,Size,as(Val,address)):-
    data_object(EA,Size,"symbol"),
    address_in_data_refined(EA,Val).

// Heuristic scores cannot prove that a numeric data word is a pointer. In
// particular, alignment, a target symbol and pointer-array shape all also
// occur in integer tables. Refuse these ambiguous ELF outputs unless the
// user explicitly opts into the old guessing policy. This is diagnostic:
// opting in retains the exact legacy inference, not a different heuristic.
.decl ambiguous_data_pointer(EA:address,Size:unsigned,Value:address,Source:symbol)
.output ambiguous_data_pointer

.decl ambiguous_data_pointer_word(EA:address,Size:unsigned,Value:address)

ambiguous_data_pointer_word(EA,Size,Value):-
    binary_format("ELF"),
    symbolic_data(EA,Size,Value),
    !relocation(EA,_,_,_,_,_,_),
    !abi_function_pointer_word(EA),
    // ELF ABI metadata (dynamic/relocation/unwind/GOT tables) has a dedicated
    // interpretation or is regenerated by the linker. This diagnostic is for
    // ordinary program data, not numeric fields in those typed formats.
    !source_in_special_data_section(EA,Size).

ambiguous_data_pointer(EA,Size,Value,Name):-
    ambiguous_data_pointer_word(EA,Size,Value),
    innermost_source_object_containing_candidate(EA,Size,Beg,ObjectSize),
    defined_symbol(Beg,ObjectSize,"OBJECT",_,_,_,_,_,Name).

ambiguous_data_pointer(EA,Size,Value,Section):-
    ambiguous_data_pointer_word(EA,Size,Value),
    !innermost_source_object_containing_candidate(EA,Size,_,_),
    loaded_section(Beg,End,Section),
    EA >= Beg, EA + Size <= End.

symbol_minus_symbol(EA,Size,Symbol1,Symbol2,Scale,Offset):-
    data_object(EA,Size,"symbol-symbol"),
    symbol_minus_symbol_candidate(EA,Size,Symbol1,Symbol2,Scale,Offset).

code_pointer_in_data(EA,Val):-
    symbolic_data(EA,_,Val),
    block(Val).

///////////////////////////////////////////////////////////////////////////////////////////
// Final label decision

labeled_ea(EA):-
    !binary_isa("ARM"),
    defined_symbol(EA,_,Type,_,_,_,_,_,_),
    Type != "SECTION",
    EA != 0.

labeled_ea(EA):-
    symbolic_operand(Src,_,EA,_),
    !moved_label(Src,_,EA,_).

labeled_ea(EA):-
    symbolic_data(Src,_,EA),
    !moved_data_label(Src,_,EA,_).

labeled_ea(EA_moved):-
    moved_label(_,_,_,EA_moved).

labeled_ea(New_dest):-
    moved_data_label(_,_,_,New_dest).

labeled_ea(EA):-
    symbol_minus_symbol(Src,_,EA,_,_,_),
    !moved_data_label(Src,_,EA,_).

labeled_ea(EA):-
    symbol_minus_symbol(Src,_,_,EA,_,_),
    !moved_data_label(Src,_,EA,_).

labeled_ea(EA):-
    fde_entry(_,_,_,_,_,EA).

labeled_ea(TargetEA):-
    // Generate labels for empty symbolic expressions
    symbolic_expr_from_relocation(_,_,"",_,TargetEA).

data_object_boundary(EA):-
    labeled_ea(EA);
    symbolic_data(EA,_,_);
    string(EA,_,_);
    symbol_minus_symbol(EA,_,_,_,_,_);
    symbolic_expr_from_relocation(EA,_,_,_,_);
    moved_data_label(EA,_,_,_).

// Keep a recovered zero-prefix alignment anchor as its own DataBlock.  The
// alignment builder can attach AuxData only to an existing block boundary.
data_object_boundary(Anchor):-
    zero_prefixed_code_object_alignment(Anchor,_,_,_).

/////////////////////////////////////////////////////////////////////////////////
// This facts specifies that a label should be printed in the .bss section for
// the given address (because it is referenced somewhere)

bss_data(Base),
bss_data(End):-
    bss_section(SectionName),
    loaded_section(Base,End,SectionName).

bss_data(EA):-
    labeled_ea(EA),
    bss_section(SectionName),
    loaded_section(Base,End,SectionName),
    EA >= Base,
    EA < End.

///////////////////////////////////////////////////////////////////////
// Final symbolic expressions in terms of symbols

// A retained PC32 relocation describes S+A-P, not an absolute pointer. For
// recognized switch entries use the proven target/table-base relationship:
// A may include the entry's offset from the table base, so using S+A as the
// target would attach a label in the middle of a different instruction after
// rewriting. The original relocation still informs earlier analyses.
.decl relative_table_relocation(EA:address)

relative_table_relocation(EA):-
    binary_format("ELF"),
    binary_isa("X64"),
    !binary_type("REL"),
    relocation(EA,"PC32",_,_,_,Section,_),
    elf_static_relocation_section(Section),
    symbol_minus_symbol(EA,4,_,_,_,_).

// A linked local transfer can retain a relocation to function+offset while
// the decoded destination is a distinct block. Rewriters move that block
// independently; preserve its identity rather than the old byte distance.
// Only consume the exact symbol identity selected by relocation processing,
// and only where both it and the encoded CFG destination agree. Dynamic text
// relocations, unresolved imports and PLT references are deliberately excluded.
.decl relocated_direct_target(Field:address,Size:unsigned,Dest:address)

relocated_direct_target(EA+FieldOffset,Size,Dest):-
    binary_format("ELF"),
    !binary_type("REL"),
    !elf_has_runtime_text_relocations(),
    instruction_immediate_offset(EA,_,FieldOffset,Size),
    relocation(EA+FieldOffset,_,_,_,_,Section,_),
    elf_static_relocation_section(Section),
    symbolic_expr_from_relocation(EA+FieldOffset,Size,Name,Addend,Base),
    Name != "",
    Addend != 0,
    (direct_call(EA,Dest); direct_jump(EA,Dest)),
    as(Dest,number) = as(Base,number) + Addend,
    code(EA),
    code(Dest),
    block(Dest),
    !plt_block(Dest,_).

labeled_ea(Dest):-
    relocated_direct_target(_,_,Dest).

symbolic_expr(Field,Size,Name,0),
symbolic_expr_symbol_address(Field,1,Name,Dest):-
    relocated_direct_target(Field,Size,Dest),
    best_symexpr_symbol(Dest,Name,"Beg").

symbolic_expr(EA,Size,Symbol,Offset):-
    symbolic_expr_from_relocation(EA,Size,Symbol,Offset,_),
    !relative_table_relocation(EA),
    !relocated_direct_target(EA,_,_),
    // Empty symbols must have a symbol name inferred.
    Symbol != "".

// Retained relocations can name distinct local definitions with the same
// spelling. The relocation lookup already selected an exact symbol address;
// do not discard that identity when materializing the expression. Imports
// without a definition intentionally retain name/version-based forwarding.
symbolic_expr_symbol_address(EA,1,Symbol,TargetEA):-
    symbolic_expr_from_relocation(EA,_,Symbol,_,TargetEA),
    !relative_table_relocation(EA),
    !relocated_direct_target(EA,_,_),
    Symbol != "",
    defined_symbol(TargetEA,_,_,_,_,_,_,_,Symbol).

symbolic_expr(EA,Size,Symbol,Offset),
symbolic_expr_symbol_address(EA,1,Symbol,TargetEA):-
    symbolic_expr_from_relocation(EA,Size,"",Offset,TargetEA),
    !relative_table_relocation(EA),
    best_symexpr_symbol(TargetEA,Symbol,_).

symbolic_expr_symbol_minus_symbol(EA,Size,SymbolName1,SymbolName2,Scale,Offset):-
    symbol_minus_symbol_from_relocation(EA,Size,SymbolName1,SymbolName2,Scale,Offset).

// Symbol-Symbol
symbolic_expr_symbol_minus_symbol(EA,Size,SymbolName1,SymbolName2,Scale,FinalOffset),
symbolic_expr_symbol_address(EA,1,SymbolName1,NewSymbol1),
symbolic_expr_symbol_address(EA,2,SymbolName2,NewSymbol2):-
    symbol_minus_symbol(EA,Size,Symbol1,Symbol2,Scale,Offset),
    (
        !symbolic_expr_from_relocation(EA,_,_,_,_);
        relative_table_relocation(EA)
    ),
    !symbol_minus_symbol_from_relocation(EA,_,_,_,_,_),
    (
        moved_data_label(EA,Size,Symbol1,NewSymbol1),
        Offset1 = Offset + as(NewSymbol1,number)- as(Symbol1,number)
        ;
        !moved_data_label(EA,_,Symbol1,_),
        NewSymbol1 = Symbol1,
        Offset1 = Offset
    ),
    (
        moved_data_label(EA,Size,Symbol2,NewSymbol2),
        FinalOffset = Offset1 + as(Symbol2,number) - as(NewSymbol2,number)
        ;
        !moved_data_label(EA,_,Symbol2,_),
        NewSymbol2 = Symbol2,
        FinalOffset = Offset1
    ),
    (
        NewSymbol1 = NewSymbol2, Symbol1Loc = Symbol2Loc;
        NewSymbol1 != NewSymbol2, Symbol1Loc = "Beg"
    ),
    best_symexpr_symbol(NewSymbol1,SymbolName1,Symbol1Loc),
    (
        boundary_sym_expr(EA,NewSymbol2,_), Symbol2Loc = "End"
        ;
        !boundary_sym_expr(EA,NewSymbol2,_), Symbol2Loc = "Beg"
    ),
    best_symexpr_symbol(NewSymbol2,SymbolName2,Symbol2Loc).

// Symbolic operands
symbolic_expr(EA+InstrOffset,Size,SymbolName,Offset),
symbolic_expr_symbol_address(EA+InstrOffset,1,SymbolName,FinalDest):-
    code(EA),
    moved_label(EA,Index,Dest,FinalDest),
    !custom_symbolic_expr_operand(EA,Index),
    (
        instruction_immediate_offset(EA,Index,InstrOffset,Size);
        instruction_displacement_offset(EA,Index,InstrOffset,Size)
    ),
    !symbolic_expr_from_relocation(EA+InstrOffset,_,_,_,_),
    !symbol_minus_symbol_from_relocation(EA+InstrOffset,_,_,_,_,_),
    !symbol_minus_symbol(EA+InstrOffset,_,_,_,_,_),
    Offset = as(Dest,number) - as(FinalDest,number),
    best_symexpr_symbol(FinalDest,SymbolName,"Beg").

symbolic_expr(EA+InstrOffset,Size,SymbolName,0),
symbolic_expr_symbol_address(EA+InstrOffset,1,SymbolName,Dest):-
    code(EA),
    symbolic_operand(EA,Index,Dest,_),
    !custom_symbolic_expr_operand(EA,Index),
    !moved_label(EA,Index,_,_),
    (
        instruction_immediate_offset(EA,Index,InstrOffset,Size);
        instruction_displacement_offset(EA,Index,InstrOffset,Size)
    ),
    !symbolic_expr_from_relocation(EA+InstrOffset,_,_,_,_),
    !symbol_minus_symbol_from_relocation(EA+InstrOffset,_,_,_,_,_),
    !symbol_minus_symbol(EA+InstrOffset,_,_,_,_,_),
    (
        boundary_sym_expr(EA+InstrOffset,Dest,_), SymbolLoc = "End"
        ;
        !boundary_sym_expr(EA+InstrOffset,Dest,_), SymbolLoc = "Beg"
    ),
    best_symexpr_symbol(Dest,SymbolName,SymbolLoc).


// Symbolic data
symbolic_expr(EA,Size,SymbolName,Offset),
symbolic_expr_symbol_address(EA,1,SymbolName,FinalDest):-
    moved_data_label(EA,Size,Dest,FinalDest),
    !symbolic_expr_from_relocation(EA,_,_,_,_),
    !symbol_minus_symbol_from_relocation(EA,_,_,_,_,_),
    !symbol_minus_symbol(EA,_,_,_,_,_),
    Offset = as(Dest,number) - as(FinalDest,number),
    best_symexpr_symbol(FinalDest,SymbolName,"Beg").

symbolic_expr(EA,Size,SymbolName,0),
symbolic_expr_symbol_address(EA,1,SymbolName,Dest):-
    symbolic_data(EA,Size,Dest),
    !symbolic_expr_from_relocation(EA,_,_,_,_),
    !symbol_minus_symbol_from_relocation(EA,_,_,_,_,_),
    !symbol_minus_symbol(EA,_,_,_,_,_),
    !moved_data_label(EA,_,_,_),
    (
        boundary_sym_expr(EA,Dest,_), SymbolLoc = "End"
        ;
        !boundary_sym_expr(EA,Dest,_), SymbolLoc = "Beg"
    ),
    best_symexpr_symbol(Dest,SymbolName,SymbolLoc).


symbolic_expr_attribute(EA+InstrOffset,Attr):-
    symbolic_operand_attribute(EA,Index,Attr),
    (
        instruction_immediate_offset(EA,Index,InstrOffset,_);
        instruction_displacement_offset(EA,Index,InstrOffset,_)
    ).
