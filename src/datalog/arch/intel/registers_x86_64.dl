/*
This module stablishes basic information about register:
 - Which registers and tracked/considered in the different analyses
 - Whether they all callee or caller saved according to the ABI

*/
reg_map_rule("AL","RAX").
reg_map_rule("AH","RAX").
reg_map_rule("BL","RBX").
reg_map_rule("BH","RBX").
reg_map_rule("CL","RCX").
reg_map_rule("CH","RCX").
reg_map_rule("DL","RDX").
reg_map_rule("DH","RDX").
reg_map_rule("DIL","RDI").
reg_map_rule("SIL","RSI").
reg_map_rule("BPL","RBP").
reg_map_rule("SPL","RSP").
reg_map_rule("R8B","R8").
reg_map_rule("R9B","R9").
reg_map_rule("R10B","R10").
reg_map_rule("R11B","R11").
reg_map_rule("R12B","R12").
reg_map_rule("R13B","R13").
reg_map_rule("R14B","R14").
reg_map_rule("R15B","R15").
reg_map_rule("AX","RAX").
reg_map_rule("BX","RBX").
reg_map_rule("CX","RCX").
reg_map_rule("DX","RDX").
reg_map_rule("DI","RDI").
reg_map_rule("SI","RSI").
reg_map_rule("BP","RBP").
reg_map_rule("SP","RSP").
reg_map_rule("R8W","R8").
reg_map_rule("R9W","R9").
reg_map_rule("R10W","R10").
reg_map_rule("R11W","R11").
reg_map_rule("R12W","R12").
reg_map_rule("R13W","R13").
reg_map_rule("R14W","R14").
reg_map_rule("R15W","R15").
reg_map_rule("EAX","RAX").
reg_map_rule("EBX","RBX").
reg_map_rule("ECX","RCX").
reg_map_rule("EDX","RDX").
reg_map_rule("EDI","RDI").
reg_map_rule("ESI","RSI").
reg_map_rule("EBP","RBP").
reg_map_rule("ESP","RSP").
reg_map_rule("R8D","R8").
reg_map_rule("R9D","R9").
reg_map_rule("R10D","R10").
reg_map_rule("R11D","R11").
reg_map_rule("R12D","R12").
reg_map_rule("R13D","R13").
reg_map_rule("R14D","R14").
reg_map_rule("R15D","R15").

reg_map_rule("EFLAGS", "RFLAGS").

general_purpose_reg("RAX").
general_purpose_reg("RBX").
general_purpose_reg("RCX").
general_purpose_reg("RDX").
general_purpose_reg("RDI").
general_purpose_reg("RSI").
general_purpose_reg("RBP").
general_purpose_reg("R8").
general_purpose_reg("R9").
general_purpose_reg("R10").
general_purpose_reg("R11").
general_purpose_reg("R12").
general_purpose_reg("R13").
general_purpose_reg("R14").
general_purpose_reg("R15").

function_non_maintained_reg("RAX").
function_non_maintained_reg("RCX").
function_non_maintained_reg("RDX").

function_non_maintained_reg("R8").
function_non_maintained_reg("R9").
function_non_maintained_reg("R10").
function_non_maintained_reg("R11").

// Additional volatile registers according to the 'System V AMD64 ABI' calling convention.
function_non_maintained_reg("RDI"),
function_non_maintained_reg("RSI"):-
    binary_format("ELF").

pc_reg("RIP").

frame_pointer("RBP").

stack_pointer("RSP").

return_reg("RAX").

condition_flags_reg("RFLAGS").

// Microsoft x64
integer_reg_param("RCX",1),
integer_reg_param("RDX",2),
integer_reg_param("R8",3),
integer_reg_param("R9",4):-
    binary_format("PE").

// System V X86_64
integer_reg_param("RDI",1),
integer_reg_param("RSI",2),
integer_reg_param("RDX",3),
integer_reg_param("RCX",4),
integer_reg_param("R8",5),
integer_reg_param("R9",6):-
    binary_format("ELF").

register_size_bytes(Reg,1):-
    Reg = "AH";
    Reg = "BH";
    Reg = "CH";
    Reg = "DH";
    Reg = "DIL";
    Reg = "SIL";
    Reg = "BPL";
    Reg = "SPL".

register_size_bytes(Reg,8):-
    Reg = "RAX";
    Reg = "RBX";
    Reg = "RCX";
    Reg = "RDX";
    Reg = "RBP";
    Reg = "RSI";
    Reg = "RDI";
    Reg = "RSP".

register_size_bytes(Reg8,1),
register_size_bytes(Reg16,2),
register_size_bytes(Reg32,4),
register_size_bytes(Reg64,8):-
    Index = range(8,16,1),
    Reg8 = cat("R", to_string(Index), "B"),
    Reg16 = cat("R", to_string(Index), "W"),
    Reg32 = cat("R", to_string(Index), "D"),
    Reg64 = cat("R", to_string(Index)).

register_size_bytes("RFLAGS",8).

arch.lra_register("RAX",0,"rax").
arch.lra_register("RBX",1,"rbx").
arch.lra_register("RCX",2,"rcx").
arch.lra_register("RDX",3,"rdx").
arch.lra_register("RDI",4,"rdi").
arch.lra_register("RSI",5,"rsi").
arch.lra_register("RBP",6,"rbp").
arch.lra_register("R8",7,"r8").
arch.lra_register("R9",8,"r9").
arch.lra_register("R10",9,"r10").
arch.lra_register("R11",10,"r11").
arch.lra_register("R12",11,"r12").
arch.lra_register("R13",12,"r13").
arch.lra_register("R14",13,"r14").
arch.lra_register("R15",14,"r15").
arch.lra_register("RFLAGS",15,"rflags").

arch.lra_caller_saved("RAX").
arch.lra_caller_saved("RCX").
arch.lra_caller_saved("RDX").
arch.lra_caller_saved("RDI"):- binary_format("ELF").
arch.lra_caller_saved("RSI"):- binary_format("ELF").
arch.lra_caller_saved("R8").
arch.lra_caller_saved("R9").
arch.lra_caller_saved("R10").
arch.lra_caller_saved("R11").
arch.lra_caller_saved("RFLAGS").

arch.lra_argument_register(Reg):-
    arch.integer_reg_param(Reg,_).
arch.lra_argument_register("RAX"):- binary_format("ELF").

arch.lra_return_register("RAX").
arch.lra_return_register("RDX"):- binary_format("ELF").

arch.lra_register_write_kills(RegIn,Reg):-
    arch.register_size_bytes(RegIn,Size),
    Size >= 4,
    reg_map(RegIn,Reg),
    // A register-width check alone cannot establish a complete flags write.
    !condition_flags_reg(Reg),
    arch.lra_register(Reg,_,_).

// LRA tracks CF/PF/AF/ZF/SF/OF as RFLAGS, not DF or other control flags.
// Mark only complete, unconditional arithmetic definitions as full writes.
// ADC/SBB's incoming carry is still a use, so lra_kill cannot discard it.
// Partial/conditional writes and undefined outputs remain conservative.
arch.register_access_override(EA,"RFLAGS","W",1):-
    instruction(EA,_,_,Operation,_,_,_,_,_,_),
    (
        Operation = "ADD";
        Operation = "SUB";
        Operation = "CMP";
        Operation = "NEG";
        Operation = "ADC";
        Operation = "SBB"
    ),
    register_access(EA,RegIn,"W"),
    reg_map(RegIn,"RFLAGS").

// A conditional move retains the old destination value when its condition is false.
arch.lra_extra_use(EA,Reg):-
    instruction(EA,_,_,Operation,_,_,_,_,_,_),
    substr(Operation,0,4) = "CMOV",
    register_access(EA,RegIn,"W"),
    reg_map(RegIn,Reg),
    arch.lra_register(Reg,_,_).

// Capstone 5 omits ADOX's destination read. Operands here use AT&T order.
arch.register_access_override(EA,Reg,"R",1):-
    instruction(EA,_,_,"ADOX",_,Destination,0,0,_,_),
    op_regdirect_contains_reg(Destination,Reg).
