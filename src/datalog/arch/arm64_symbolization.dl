/**
ARM64 architecture-specific rules for symbolization
*/

avoid_symbols("$x").

// Capstone represents literal LDR/LDRSW targets as absolute memory operands, but
// the encoding is PC-relative in both EXEC and DYN files. Do not rely on the
// EXEC-only numeric-immediate heuristic: relinking a DSO must relocate these
// references too. Register and base+displacement loads do not match this form.
pc_relative_operand(EA,1,as(Target,address)):-
    instruction(EA,_,_,Operation,MemOp,RegOp,0,0,_,_),
    (Operation = "LDR"; Operation = "LDRSW"),
    op_indirect_mapped(MemOp,"NONE","NONE","NONE",_,Target,_),
    op_regdirect_contains_reg(RegOp,_),
    !instruction_has_relocation(EA,_).

/**
Compute an immediate load performed across two consecutive instructions
*/
.decl split_load(ea:address, nextea:address, dest:address, type:symbol)

/** E.g.,
adrp x0, L1
add x0, x0, :lo12:L1
*/
split_load(EA, NextEA, as(Base + Offset,address), "ADD") :-
    // ADRP/ADR <Register> <Immediate>
    // e.g. adrp x0, BaseOp
    instruction_get_operation(EA,ADROperation),
    substr(ADROperation,0,3) = "ADR",
    instruction_get_op(EA, 1, BaseOp),
    op_immediate(BaseOp, Base,_),
    instruction_get_op(EA, 2, RegOp),
    op_regdirect_contains_reg(RegOp,Reg),

    // NOTE: Can't use def_used due to cyclic negation issue.
    //       This is a heuristic to look at next one or two instruction(s)
    //       to find ADD instruction.
    (
        next(EA, NextEA)
        ;
        next(EA, NextEA0), next(NextEA0, NextEA),
        instruction_get_dest_op(NextEA0,_,TmpOp),
        !op_regdirect_contains_reg(TmpOp,Reg)
    ),

    // ADD <Register> <Register> <Immediate>
    // e.g. add x0, x0, <OffsetOp>
    instruction_get_operation(NextEA, "ADD"),
    instruction_get_op(NextEA, 2, OffsetOp),
    op_immediate(OffsetOp, Offset,_),
    instruction_get_op(NextEA, 1, RegOp2),
    op_regdirect_contains_reg(RegOp2,Reg2),
    // Make sure the registers match
    Reg = Reg2.

/** E.g.,
adrp x0, L1
ldr x0, [x0,:lo12:L1]
*/
split_load(EA, NextEA, as(Base + Offset,address), "LDR/STR") :-
    // ADRP/ADR <Register> <Immediate>
    // e.g. adrp x0, BaseOp
    instruction_get_operation(EA,ADROperation),
    substr(ADROperation,0,3) = "ADR",
    instruction_get_op(EA, 1, BaseOp),
    op_immediate(BaseOp, Base,_),
    instruction_get_op(EA, 2, RegOp),
    op_regdirect_contains_reg(RegOp,Reg),

    // NOTE: Can't use def_used due to cyclic negation issue.
    //       This is a heuristic to look at next one or two instruction(s)
    //       to find LDR or STR instruction.
    (
        next(EA,NextEA)
        ;
        next(EA,NextEA0), next(NextEA0,NextEA),
        NextEA0 != NextEA,
        instruction_get_dest_op(NextEA0,_,TmpOp),
        !op_regdirect_contains_reg(TmpOp,Reg)
    ),

    // LDR/STR <Register> <IndirectOp>
    // e.g. ldr x0, [x0, <OffsetOp>]
    instruction_get_operation(NextEA, Operation),
    (
        arch.load_operation(Operation)
        ;
        arch.store_operation(Operation)
    ),
    instruction_get_op(NextEA, 1, OffsetOp),

    op_indirect_mapped(OffsetOp,"NONE",Reg,"NONE",_,Offset,_).


plt_entry(EA_jump,Function):-
    plt_section(SecName),
    loaded_section(Beg,End,SecName),
    EA >= Beg,
    EA < End,
    split_load(_, EA, Got_entry, "LDR/STR"),
    next(EA,EA_next),
    next(EA_next,EA_jump),
    reg_jump(EA_jump,_),
    relocation(Got_entry,_,Function,_,_,_,_),
    Function != "".

/**
A reference to a page-aligned value loaded by an adr or adrp instruction.

EA: Address of the adr/adrp instruction
Reg: The register that holds the used value
UsedEA: Address where the value is used
Dest: The destination address

We care primarily about adrp, but sometimes if the target is close enough,
the assembler will substitute an adr to the page-aligned address instead.

Reg is not necessarily the register loaded by adrp! It may be the result of:

    adrp x0, label
    mov x1, x0
UsedEA:
    # x1 is used

and Reg would be `x1`
*/
.decl adrp_used(EA:address,Reg:register,UsedEA:address,Dest:address)

// Track an ADR/ADRP page value only through operations that preserve it
// exactly.  In particular, stop at ADD: that instruction is itself the LO12
// tail which completes the address.  This explicit provenance avoids treating
// a completed page-aligned pointer as a fresh page base after a register copy
// or stack spill/reload.
.decl adrp_page_value_flow(
          ADREA:address,EARegDef:address,Reg:register,Dest:address)

adrp_page_value_flow(EA,EA,Reg,Dest):-
    arch.adr_dest(EA,Reg,Dest).

// Register copies preserve an uncompleted ADRP page value.
adrp_page_value_flow(ADREA,MoveEA,DstReg,Dest):-
    adrp_page_value_flow(ADREA,PrevEA,SrcReg,Dest),
    reg_def_use.def_used(PrevEA,SrcReg,MoveEA,_),
    arch.move_reg_reg(MoveEA,DstReg,SrcReg).

// Preserve the page-base provenance across an exact stack spill/reload.
adrp_page_value_flow(ADREA,LoadEA,DstReg,Dest):-
    adrp_page_value_flow(ADREA,PrevEA,SrcReg,Dest),
    reg_def_use.def_used(PrevEA,SrcReg,StoreEA,_),
    arch.store(StoreEA,_,_,SrcReg,StoreBase,"NONE",_,StoreOffset),
    stack_def_use.def_used(
        StoreEA,[StoreBase,StoreOffset],
        LoadEA,[LoadBase,LoadOffset],_),
    arch.load(LoadEA,_,_,DstReg,LoadBase,"NONE",_,LoadOffset).

adrp_used(EA,Reg,UsedEA,Dest):-
    adrp_page_value_flow(EA,EARegDef,Reg,Dest),
    reg_def_use.def_used(EARegDef,Reg,UsedEA,_),
    // Ensure that Dest is page-aligned - otherwise it is an exact ADR value,
    // not a page base awaiting a split-load tail.
    Dest band 0xFFF = 0.

/**
An instruction which could be the second half of a split load.
*/
.decl split_load_tail(EA:address,Offset:number,Reg:register,Type:symbol)

// ADD <Register> <Register> <Immediate>
// e.g. add x0, x0, <Offset>
split_load_tail(EA,Offset,Reg,Type):-
    arch.reg_arithmetic_operation(EA,_,Reg,1,Offset),
    !arch.memory_access(_,EA,_,_,_,_,_,_,_),
    Type = "ADD".

// LDR/STR <Register> <IndirectOp>
// e.g. ldr x0, [x0, <OffsetOp>]
split_load_tail(EA,Offset,Reg_nn,Type):-
    arch.memory_access(_,EA,_,_,_,Reg,"NONE",_,Offset),
    // A post-index amount updates the base after the access, not its address.
    !instruction_post_index(EA),
    reg_nonnull(Reg,Reg_nn),
    Type = "LDR/STR".

/**
This version of split_load uses def_used, so this should not be used for
the code inference step due to cyclic negation issue.
Instead, this is for the symbolization step.
*/
.decl split_load_for_symbolization(ea:address, nextea:address, dest:address, type:symbol)

// Direct split load
split_load_for_symbolization(EA,UsedEA,as(as(Base,number)+Offset,address),Type):-
    adrp_used(EA,Reg,UsedEA,Base),
    split_load_tail(UsedEA,Offset,Reg,Type).

// ADR encodes the exact byte address in its immediate.  Keep that exact base
// when the value is subsequently used with an offset.  Rebasing the ADR to
// Base+Offset and retaining the offset in the consumer applies the offset
// twice.  ADRP is different: it encodes only a page, so selecting the final
// destination here remains layout-neutral and lets the consumer carry LO12.
split_load_operand(EA, 1, as(Base,address)) :-
    split_load_for_symbolization(EA, _, _, _),
    instruction_get_operation(EA,"ADR"),
    arch.adr_dest(EA,_,Base).

split_load_operand(EA, 1, as(Dest,address)) :-
    split_load_for_symbolization(EA, _, Dest, _),
    instruction_get_operation(EA,"ADRP").

split_load_operand(EA, 1, as(Dest,address)) :-
    split_load_for_symbolization(_, EA, Dest, "LDR/STR").

split_load_operand(EA, 2, as(Dest,address)) :-
    split_load_for_symbolization(_, EA, Dest, "ADD").

// ADR preserves an exact address, so its consumer needs the byte difference
// from that base, not the final target's page offset. Keep this distinction
// through the existing register-copy and stack-spill provenance rules.
.decl arm64_exact_base_operand(EA:address,Index:operand_index,Base:address,Dest:address)

arm64_exact_base_operand(EA,Index,Base,Dest):-
    split_load_for_symbolization(ADREA,EA,Dest,Type),
    instruction_get_operation(ADREA,"ADR"),
    arch.adr_dest(ADREA,_,Base),
    !relocation(EA,_,_,_,_,_,_),
    (
        Type = "ADD", Index = 2;
        Type = "LDR/STR", Index = 1
    ).

symbol_minus_symbol(EA+InstrOffset,Size,Base,Dest,1,0):-
    arm64_exact_base_operand(EA,Index,Base,Dest),
    code(EA),
    (
        instruction_immediate_offset(EA,Index,InstrOffset,Size);
        instruction_displacement_offset(EA,Index,InstrOffset,Size)
    ).

// The high and low expressions must agree on which side of a section
// boundary they denote, including after the sections move to different pages.
boundary_sym_expr(EA,Dest,Reason):-
    split_load_for_symbolization(EA,TailEA,Dest,"ADD"),
    instruction_get_operation(EA,"ADRP"),
    symbolic_operand(EA,1,Dest,"data"),
    boundary_sym_expr(TailEA,Dest,Reason).


// Linker-defined objects may lie in an alignment gap outside any section.
// Express them relative to the relocatable end of their owning section.
.decl arm64_split_load_symbol_after_section(EA:address,Index:operand_index,Dest:address,SectionEnd:address)

arm64_split_load_symbol_after_section(EA,Index,Dest,SectionEnd):-
    split_load_operand(EA,Index,Dest),
    symbol(Dest,_,SymbolType,_,_,SectionIndex,_,_,_),
    SymbolType != "FUNC",
    SymbolType != "SECTION",
    SectionIndex != 0,
    section(_,SectionSize,SectionBeg,_,SectionIndex),
    SectionEnd = SectionBeg + SectionSize,
    Dest > SectionEnd,
    !loaded_section(Dest,_,_).

symbolic_operand_candidate(EA,Index,Dest,"data"):-
    arm64_split_load_symbol_after_section(EA,Index,Dest,_).

custom_symbolic_expr_operand(EA,Index):-
    arm64_split_load_symbol_after_section(EA,Index,_,_).

// The custom expression below needs an end-position symbol, not a symbol at
// the beginning of an adjacent section. Request that anchor explicitly even
// when no original symbol names the owner's end. Otherwise the custom rule
// suppresses ordinary symbolization but cannot emit its own expression.
labeled_ea(SectionEnd),
boundary_sym_expr(EA,SectionEnd,"symbol beyond owning section"):-
    arm64_split_load_symbol_after_section(EA,_,_,SectionEnd).

symbolic_expr(EA+InstrOffset,Size,SymbolName,Offset),
symbolic_expr_symbol_address(EA+InstrOffset,1,SymbolName,SectionEnd):-
    arm64_split_load_symbol_after_section(EA,Index,Dest,SectionEnd),
    (
        instruction_immediate_offset(EA,Index,InstrOffset,Size);
        instruction_displacement_offset(EA,Index,InstrOffset,Size)
    ),
    !symbolic_expr_from_relocation(EA+InstrOffset,_,_,_,_),
    !symbol_minus_symbol_from_relocation(EA+InstrOffset,_,_,_,_,_),
    !symbol_minus_symbol(EA+InstrOffset,_,_,_,_,_),
    Offset = as(Dest,number) - as(SectionEnd,number),
    best_symexpr_symbol(SectionEnd,SymbolName,"End").


/**
ARM64: ex_false_pointer_array: optimized (e.g., -O2):

6e4:   adrp x0, .L_11018
6e8:   mov fp,sp
6ec:   stp x19,x20,[sp,#16]
6f0:   add x20,x0, :lo12:.L_11018
6f4:   mov x19,#0
6f8:   ldr x0,[x0,:lo12:.L_11018]

In optimized binary as above, there may be cases where one adrp instruction
is shared among multiple split_loads, such as the add and ldr:
(0x6e4,0x6f0), (0x6e4,06f8), respectively.
The relocation type of the object at .L_11018 is RELATIVE (global data
object).
In such case, using :got: for adrp and :got_lo12: for ldr causes runtime
failure. To avoid the problem, the relocation directives are not used for adrp and ldr.
*/
.decl arm64_got_slot(GotEntry:address)

arm64_got_slot(GotEntry):-
    loaded_section(Beg,End,".got"),
    Beg <= GotEntry, GotEntry < End,
    arch.pointer_size(Ptr),
    GotEntry % Ptr = 0,
    relocation(GotEntry,RelType,Symbol,_,SymbolIndex,_,_),
    RelType != "RELATIVE",
    !tls_index(GotEntry,_),
    !tls_descriptor(GotEntry,_),
    symbol(_,_,_,_,_,_,_,SymbolIndex,Symbol).

arm64_got_slot(GotEntry):-
    // A linker-local/hidden definition can leave a RELATIVE relocation in
    // an actual GOT slot. Its addend identifies the resolved symbol, rather
    // than a dynamic-symbol index. Do not extend this to ordinary .data:
    // ADRP+LDR of a relocated pointer there is not a GOT access.
    loaded_section(Beg,End,".got"),
    Beg <= GotEntry, GotEntry < End,
    arch.pointer_size(Ptr),
    GotEntry % Ptr = 0,
    relocation(GotEntry,"RELATIVE","",Target,_,_,_),
    Target != 0,
    !tls_index(GotEntry,_),
    !tls_descriptor(GotEntry,_),
    symbol(as(Target,address),_,_,_,_,_,_,_,_).

arm64_got_slot(GotEntry):-
    loaded_section(Beg,End,".got"),
    Beg <= GotEntry, GotEntry < End,
    arch.pointer_size(Ptr),
    GotEntry % Ptr = 0,
    !relocation(GotEntry,_,_,_,_,_,_),
    !tls_index(GotEntry,_),
    !tls_descriptor(GotEntry,_),
    address_in_data(GotEntry,Target),
    symbol(Target,_,_,_,_,_,_,_,_).

symbolic_operand_attribute(EA,1,"GOT"),
symbolic_operand_attribute(EA_ldr,1,"GOT"),
symbolic_operand_attribute(EA_ldr,1,"LO12"):-
    split_load_for_symbolization(EA,EA_ldr,Dest,"LDR/STR"),
    instruction_get_operation(EA,"ADRP"),
    !split_load_for_symbolization(EA,EA_ldr,Dest,"ADD"),
    arm64_got_slot(Dest).

symbolic_operand_attribute(EA,1,"LO12"):-
    split_load_for_symbolization(EA0,EA,Dest,"LDR/STR"),
    !arm64_exact_base_operand(EA,1,_,_),
    !relocation(EA,_,_,_,_,_,_),
    (
        !relocation(Dest,_,_,_,_,_,_),
        UNUSED(EA0)
        ;
        split_load_for_symbolization(EA0,_,Dest,"ADD")
        ;
        loaded_section(Beg,End,".got"),
        (
            Beg > Dest, UNUSED(End);
            Dest >= End, UNUSED(Beg)
        ),
        UNUSED(EA0)
    ).

symbolic_operand_attribute(EA,2,"LO12"):-
    split_load_for_symbolization(_,EA,Dest,"ADD"),
    !arm64_exact_base_operand(EA,2,_,_),
    !relocation(EA,_,_,_,_,_,_),
    !relocation(as(Dest,address),"GLOB_DAT",_,_,_,_,_).

/**
OpIndex: operand index for the corresponding relocation
*/
.decl lo_reloc_index(RelocType:symbol, OpIndex:unsigned)

lo_reloc_index("ADD_ABS_LO12_NC", 2).
lo_reloc_index("LDST8_ABS_LO12_NC", 1).
lo_reloc_index("LDST16_ABS_LO12_NC", 1).
lo_reloc_index("LDST32_ABS_LO12_NC", 1).
lo_reloc_index("LDST64_ABS_LO12_NC", 1).
lo_reloc_index("LDST128_ABS_LO12_NC", 1).

symbolic_operand_attribute(EA,OpIndex,"LO12"):-
    relocation(EA,RelocType,_,_,_,_,"RELA"),
    lo_reloc_index(RelocType,OpIndex).

// Instruction relocations occupy four bytes, including CALL26/JUMP26 whose
// names describe the immediate bit count rather than the relocated width.
.decl arm64_instruction_relocation(Type:symbol)

arm64_instruction_relocation(Type):- lo_reloc_index(Type,_).
arm64_instruction_relocation("ADR_PREL_PG_HI21").
arm64_instruction_relocation("ADR_PREL_PG_HI21_NC").
arm64_instruction_relocation("CALL26").
arm64_instruction_relocation("JUMP26").

// Keep a named anchor and its signed addend separately. TargetEA identifies
// the anchor, so exact symbol lookup must not include the addend a second time.
symbolic_expr_from_relocation(EA,4,Symbol,Addend,SymAddr):-
    relocation(EA,Type,Symbol,Addend,SymbolIndex,_,"RELA"),
    arm64_instruction_relocation(Type),
    Symbol != "",
    symbol(SymAddr,_,_,_,_,_,_,SymbolIndex,Symbol).

// An unnamed section anchor is replaced by a symbol at its resolved target.
// The section-relative addend has already been consumed in that resolution.
symbolic_expr_from_relocation(EA,4,"",0,Dest):-
    relocation(EA,Type,"",Addend,SymbolIndex,_,"RELA"),
    arm64_instruction_relocation(Type),
    symbol(SymAddr,_,"SECTION",_,_,_,_,SymbolIndex,""),
    Dest = as(as(SymAddr,number)+Addend,address).

value_reg(EA,Reg,EA,"NONE",0,Val,1):-
    split_load_for_symbolization(_,EA,RefAddr,_),
    arch.load(EA,OpIndex,_,Reg,_,_,_,_),
    track_register(Reg),
    instruction_get_op(EA,OpIndex,Op1),
    op_indirect(Op1,_,_,_,_,_,DataSize),
    data_word(RefAddr,DataSize,Val).

symbolic_operand_candidate(EA,1,Dest,Type):-
    // ADR <Register> <Immediate>
    // e.g. adr r1, BaseOp
    code(EA),
    instruction_get_operation(EA, Operation),
    (
        Operation = "ADR";
        Operation = "ADRP"
    ),
    !split_load_operand(EA,1,_),
    instruction_get_op(EA, 1, OffsetOp),
    op_immediate(OffsetOp, Offset,_),
    Dest = as(Offset,address),
    (
        code(Dest), Type="code"
        ;
        data_segment(Begin,End),
        Dest >= Begin, Dest <= End,
        Type = "data"
    ).

unlikely_have_symbolic_immediate(EA):-
    instruction_get_operation(EA, Operation),
    contains("ADD", Operation),
    !split_load(_,EA,_,"ADD").

// ===================================================================
// MOVZ + MOVK address construction
// ===================================================================
//
// In non-PIE ARM64 binaries, absolute addresses are often constructed
// using a MOVZ+MOVK instruction sequence:
//
//   movz x0, #0x0, lsl #16  ; x0 = 0x00000000
//   movk x0, #0x4170        ; x0 = 0x00004170  (address of some symbol)
//
// Each instruction writes a 16-bit slice of the destination register.
// The shift amount (lsl #0, #16, #32, #48) selects which slice is updated.
// MOVZ initializes the register by zeroing all other bits, while
// subsequent MOVK instructions overwrite only their selected 16-bit
// slice without affecting the rest of the register.
//
// This is analogous to ARM32's MOVW+MOVT sequence (see arm32_binaries.dl).
// ===================================================================

/**
Individual MOVZ or MOVK instruction with its 16-bit immediate and shift.
*/
.decl movz_movk_insn(EA:address, Reg:register, Val:number, ShiftMask:unsigned, Operation:symbol)

movz_movk_insn(EA, Reg, Value, ShiftMask, Operation):-
    instruction_get_operation(EA, Operation),
    (Operation = "MOVZ" ; Operation = "MOVK"),
    arch.move_reg_imm(EA, Reg, Imm, _),
    (
        op_shifted(EA, 1, Shift, "LSL")
        ;
        Shift = 0,
        !op_shifted(EA, 1, _, _)
    ),
    Shift % 16 = 0,
    Value = (Imm band 0xFFFF) * 2^as(Shift,number),
    ShiftMask = 1 bshl (Shift bshr 4).

/**
A chain of MOVZ followed by one or more MOVKs to the same register.
EA_first is always the MOVZ instruction.
EA_last is the final instruction in the chain.
Value is the accumulated 64-bit constant constructed from all instructions.
UsedShiftMask tracks which 16-bit lanes have been written.
Count is the number of instructions in the chain (1-4).
*/
.decl movz_movk_chain(EA_first:address, EA_last:address, Reg:register, Value:number, UsedShiftMask:unsigned, Count:unsigned)

// Base case: single MOVZ initializes the chain.
movz_movk_chain(EA_movz, EA_movz, Reg, Value, UsedShiftMask, 1):-
    movz_movk_insn(EA_movz, Reg, Value, UsedShiftMask, "MOVZ").

// Recursive case: extend chain with a consecutive MOVK to the same register.
movz_movk_chain(EA_start, EA_last, Reg, Value, UsedShiftMask, Count+1):-
    movz_movk_chain(EA_start, EA_prev, Reg, PrevValue, PrevShiftMask, Count),
    next(EA_prev, EA_last),
    movz_movk_insn(EA_last, Reg, CurrValue, CurrShiftMask, "MOVK"),

    // Ensure the MOVK writes to a previously unused 16-bit lane.
    PrevShiftMask band CurrShiftMask = 0,

    UsedShiftMask = PrevShiftMask bor CurrShiftMask,
    Value = PrevValue bor CurrValue.

/**
The longest complete MOVZ+MOVK chain: a chain that cannot be extended further.
This is the one we use for symbolization.
*/
.decl movz_movk_complete(EA_first:address, EA_last:address, Value:number)

movz_movk_complete(EA_first, EA_last, Value):-
    movz_movk_chain(EA_first, EA_last, _, Value, _, Count),
    !movz_movk_chain(EA_first, _, _, _, _, Count+1).

/**
Helper: is EA part of a complete MOVZ+MOVK chain?
*/
.decl movz_movk_member(EA:address, EA_first:address, EA_last:address)

// The MOVZ itself.
movz_movk_member(EA_first, EA_first, EA_last):-
    movz_movk_complete(EA_first, EA_last, _).

// Each MOVK in the chain.
movz_movk_member(EA, EA_first, EA_last):-
    movz_movk_complete(EA_first, EA_last, _),
    movz_movk_chain(EA_first, EA, _, _, _, _),
    EA != EA_first.

// Zero-valued upper MOVK lanes must still relocate if the complete address
// later crosses a 16-bit boundary. The standalone-immediate bitmask heuristic
// must not discard just those lanes of an otherwise recognized construction.
// Scalar-use penalties below still judge the value of the *whole* chain.
reconstructed_address_fragment(EA,1):-
    movz_movk_member(EA,EA_first,EA_last),
    movz_movk_chain(EA_first,EA_last,_,_,_,Count),
    Count > 1.

/**
Helper: map a shift amount to the corresponding group attribute name.
*/
.decl movz_movk_shift_group(ShiftMask:unsigned, Group:symbol)

movz_movk_shift_group(1, "G0").
movz_movk_shift_group(2, "G1").
movz_movk_shift_group(4, "G2").
movz_movk_shift_group(8, "G3").

/**
For non-PIE (EXEC) binaries, generate symbolic operand candidates
when a complete MOVZ+MOVK chain constructs a value that matches a known
code or data address. Each instruction gets a G0-G3 attribute
indicating which 16-bit group it contributes.
*/
symbolic_operand_attribute(EA, 1, Group),
symbolic_operand_candidate(EA, 1, Dest, Type):-
    binary_type("EXEC"),
    movz_movk_complete(EA_first, EA_last, Value),
    Dest = as(Value, address),
    (
        code(Dest), Type = "code"
        ;
        data_segment(Begin, End),
        Dest >= Begin, Dest <= End,
        Type = "data"
    ),
    movz_movk_member(EA, EA_first, EA_last),
    movz_movk_insn(EA, _, _, ShiftMask, _),
    movz_movk_shift_group(ShiftMask, Group).

// Track only operations that preserve the address represented by a completed
// MOVZ/MOVK chain.  The generic def_used_for_address relation is deliberately
// broader: it propagates through arithmetic and therefore also classifies an
// integer that is shifted/masked and later used as an array index as "Memory".
// That broad relation is useful elsewhere, but is not sufficient evidence that
// the original MOVZ/MOVK constant itself is a pointer.
.decl movz_movk_address_value_flow(
          EA_first:address,EA_last:address,EA_def:address,Reg:register)

movz_movk_address_value_flow(EA_first,EA_last,EA_last,Reg):-
    movz_movk_complete(EA_first,EA_last,_),
    movz_movk_insn(EA_last,Reg,_,_,_).

// Register copies preserve the represented address.
movz_movk_address_value_flow(EA_first,EA_last,EA_move,DstReg):-
    movz_movk_address_value_flow(EA_first,EA_last,EA_def,SrcReg),
    reg_def_use.def_used(EA_def,SrcReg,EA_move,_),
    arch.move_reg_reg(EA_move,DstReg,SrcReg).

// Adding a constant is ordinary pointer arithmetic.  Other arithmetic,
// shifts, masks, and scaled-index calculations intentionally do not flow.
movz_movk_address_value_flow(EA_first,EA_last,EA_add,DstReg):-
    movz_movk_address_value_flow(EA_first,EA_last,EA_def,SrcReg),
    reg_def_use.def_used(EA_def,SrcReg,EA_add,_),
    arch.reg_arithmetic_operation(EA_add,DstReg,SrcReg,1,_).

// Preserve exact stack spill/reload provenance for address materializations.
movz_movk_address_value_flow(EA_first,EA_last,EA_load,DstReg):-
    movz_movk_address_value_flow(EA_first,EA_last,EA_def,SrcReg),
    reg_def_use.def_used(EA_def,SrcReg,EA_store,_),
    arch.store(EA_store,_,_,SrcReg,StoreBase,"NONE",_,StoreOffset),
    stack_def_use.def_used(
        EA_store,[StoreBase,StoreOffset],
        EA_load,[LoadBase,LoadOffset],_),
    arch.load(EA_load,_,_,DstReg,LoadBase,"NONE",_,LoadOffset).

.decl movz_movk_demonstrated_address_use(
          EA_first:address,EA_last:address)

movz_movk_demonstrated_address_use(EA_first,EA_last):-
    movz_movk_address_value_flow(EA_first,EA_last,EA_def,Reg),
    reg_def_use.def_used(EA_def,Reg,EA_use,_),
    arch.memory_access(
        _,EA_use,_,_,_,as(Reg,reg_nullable),_,_,_).

movz_movk_demonstrated_address_use(EA_first,EA_last):-
    movz_movk_address_value_flow(EA_first,EA_last,EA_def,Reg),
    reg_def_use.def_used(EA_def,Reg,EA_use,_),
    (
        reg_call(EA_use,Reg)
        ;
        reg_jump(EA_use,Reg)
    ).

// A completed MOVZ/MOVK value that merely lands on an unlabeled instruction
// can be a scalar bit mask rather than an address.  This is especially easy
// to misclassify in a non-PIE executable because ordinary flag constants may
// numerically overlap .text.  A direct logical use whose result is not used to
// form an address is scalar evidence.  Keep the penalty modest: any independent
// address-use score still retains symbolization, as do relocations, exact
// target symbols, and the value-preserving address flows above.
.decl movz_movk_scalar_logical_use(
          EA_first:address,EA_last:address)

movz_movk_scalar_logical_use(EA_first,EA_last):-
    movz_movk_address_value_flow(EA_first,EA_last,EA_def,Reg),
    reg_def_use.def_used(EA_def,Reg,EA_logic,_),
    instruction_get_operation(EA_logic,Operation),
    arch.logic_operation(Operation),
    instruction_get_dest_op(EA_logic,_,DestOp),
    op_regdirect_contains_reg(DestOp,ResultReg),
    !def_used_for_address(EA_logic,ResultReg,_).

symbolic_operand_point(EA,1,-1,
                       "MOVZ/MOVK scalar points inside unlabeled code"):-
    movz_movk_member(EA,EA_first,EA_last),
    symbolic_operand_candidate(EA,1,Dest,"code"),
    !instruction_has_relocation(EA,_),
    !defined_symbol(Dest,_,_,_,_,_,_,_,_),
    !movz_movk_demonstrated_address_use(EA_first,EA_last),
    movz_movk_scalar_logical_use(EA_first,EA_last).

// A 32/64-bit scalar assembled by MOVZ+MOVK can accidentally equal an
// address strictly inside a nonzero data OBJECT.  Symbolizing that coincidence
// is not layout-neutral: a later rewrite moves the object, and the linker then
// changes the intended integer.  The -2 score deliberately dominates the
// generic +1 used-for-address score when that score came only from a scalar
// index computation.  Relocations, exact target symbols, and demonstrated
// address-value flow remain intact.
symbolic_operand_point(EA,1,-2,
                       "MOVZ/MOVK scalar points inside unlabeled data object"):-
    movz_movk_member(EA,EA_first,EA_last),
    symbolic_operand_candidate(EA,1,Dest,"data"),
    !instruction_has_relocation(EA,_),
    !movz_movk_demonstrated_address_use(EA_first,EA_last),
    defined_symbol(Beg,Size,"OBJECT",_,_,_,_,_,_),
    Size > 0,
    Dest > Beg,
    Dest < Beg+Size,
    !defined_symbol(Dest,_,_,_,_,_,_,_,_).

may_have_symbolic_immediate(EA, as(Value, address)):-
    movz_movk_complete(EA_first, EA_last, Value),
    movz_movk_member(EA, EA_first, EA_last).

// Immediate in movz or movk may not be symbolic unless the instruction is part of movz_movk_chain.
unlikely_have_symbolic_immediate(EA):-
    instruction_get_operation(EA, Operation),
    (Operation = "MOVZ" ; Operation = "MOVK"),
    !movz_movk_member(EA, _, _).
